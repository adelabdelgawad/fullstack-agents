#!/usr/bin/env bash
# SessionStart hook for fullstack-agents plugin

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

source "${SCRIPT_DIR}/lib.sh"

# --- Read hook input (may be empty when invoked outside Claude Code) ---
hook_input=""
if [ ! -t 0 ]; then
    hook_input=$(cat || true)
fi

# Extract the SessionStart source (startup|resume|clear|compact). On
# resume/compact the prior context (or its summary) already carries the
# full guide, so we inject only a short reminder to save context.
session_source="startup"
case "$hook_input" in
    *'"source"'*)
        session_source=$(printf '%s' "$hook_input" \
            | sed -n 's/.*"source"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p')
        [ -n "$session_source" ] || session_source="startup"
        ;;
esac

# --- Project Detection ---
# Lightweight checks for FastAPI + Next.js project markers
project_info=""

# FastAPI detection
if [ -f "pyproject.toml" ] && grep -qi "fastapi" pyproject.toml 2>/dev/null; then
    project_info="${project_info}FastAPI backend detected (pyproject.toml). "
elif [ -f "requirements.txt" ] && grep -qi "fastapi" requirements.txt 2>/dev/null; then
    project_info="${project_info}FastAPI backend detected (requirements.txt). "
elif [ -f "src/backend/pyproject.toml" ] && grep -qi "fastapi" src/backend/pyproject.toml 2>/dev/null; then
    project_info="${project_info}FastAPI backend detected (src/backend/). "
fi

# Rust detection (root or one level down, e.g. services/<name>/Cargo.toml)
if [ -f "Cargo.toml" ]; then
    project_info="${project_info}Rust workspace detected (Cargo.toml). "
else
    rust_manifest=$(find . -maxdepth 2 -name Cargo.toml -not -path "./target/*" 2>/dev/null | head -1)
    if [ -n "$rust_manifest" ]; then
        project_info="${project_info}Rust service detected (${rust_manifest#./}). "
    fi
fi

# Next.js detection
if [ -f "package.json" ] && grep -q '"next"' package.json 2>/dev/null; then
    project_info="${project_info}Next.js frontend detected (package.json). "
elif [ -f "src/frontend/package.json" ] && grep -q '"next"' src/frontend/package.json 2>/dev/null; then
    project_info="${project_info}Next.js frontend detected (src/frontend/). "
fi

# Docker detection
if [ -f "docker-compose.yml" ] || [ -f "docker-compose.yaml" ]; then
    project_info="${project_info}Docker infrastructure detected. "
fi

# Default message if nothing detected
if [ -z "$project_info" ]; then
    project_info="No FastAPI/Next.js project detected. Fullstack-agents skills are available if needed."
fi

# --- Escape for JSON ---
# Prefer a real JSON encoder; the manual fallback covers the common escapes
# but cannot handle every control character.
PYTHON_BIN=$(find_python || true)

escape_for_json() {
    local s="$1"
    if [ -n "$PYTHON_BIN" ]; then
        printf '%s' "$s" | "$PYTHON_BIN" -c 'import json,sys; print(json.dumps(sys.stdin.read())[1:-1])'
    elif command -v jq >/dev/null 2>&1; then
        printf '%s' "$s" | jq -Rs '.' | sed 's/^"//; s/"$//'
    else
        s="${s//\\/\\\\}"
        s="${s//\"/\\\"}"
        s="${s//$'\n'/\\n}"
        s="${s//$'\r'/\\r}"
        s="${s//$'\t'/\\t}"
        printf '%s' "$s"
    fi
}

project_info_escaped=$(escape_for_json "$project_info")

if [ "$session_source" = "compact" ] || [ "$session_source" = "resume" ]; then
    # Short reminder — the full guide was injected at startup and survives in
    # the conversation summary; re-injecting it would burn context every compact.
    session_context="<EXTREMELY_IMPORTANT>\nYou have fullstack-agents.\n\n**Project Detection:** ${project_info_escaped}\n\nThe 'fullstack-agents:using-fullstack-agents' skill governs ALL FastAPI/Next.js code generation: before writing ANY backend or frontend code, run the 5-step gate (DETECT intent -> MATCH against the routing table -> REUSE: search for existing implementations, never duplicate -> INVOKE the matching skill -> ensure codebase-scanning ran this session), and after generation the chain GENERATE -> REVIEW PATTERNS -> FIX -> VALIDATE is mandatory. The 'fullstack-agents:senior-engineer' discipline (search-before-implement, no duplication, functions < 50 lines, files < 800 lines) applies to ALL implementation work. LANGUAGE LANES are strict: Rust files use rust-* skills only, Python files use fastapi/python-clean-architecture only — never blend idioms; Rust endpoints consumed by Next.js must follow rust-nextjs-contract. If the routing table is no longer in context, invoke 'fullstack-agents:using-fullstack-agents' via the Skill tool to reload it.\n</EXTREMELY_IMPORTANT>"
else
    # --- Read bootstrapping skill ---
    using_skill_content=$(cat "${PLUGIN_ROOT}/skills/using-fullstack-agents/SKILL.md" 2>&1 || echo "Error reading using-fullstack-agents skill")
    using_skill_escaped=$(escape_for_json "$using_skill_content")
    session_context="<EXTREMELY_IMPORTANT>\nYou have fullstack-agents.\n\n**Project Detection:** ${project_info_escaped}\n\n**Below is the full content of your 'fullstack-agents:using-fullstack-agents' skill — your guide to auto-triggering code generation skills. For all other skills, use the 'Skill' tool:**\n\n---\n\n${using_skill_escaped}\n\n</EXTREMELY_IMPORTANT>"
fi

# Output context injection as JSON.
# Keep both shapes for compatibility:
# - Cursor hooks expect additional_context.
# - Claude hooks expect hookSpecificOutput.additionalContext.
cat <<EOF
{
  "additional_context": "${session_context}",
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "${session_context}"
  }
}
EOF

exit 0
