#!/usr/bin/env bash
# SessionStart hook for fullstack-agents plugin

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

source "${SCRIPT_DIR}/lib.sh"

# --- Read hook input (may be empty when invoked outside Claude Code) ---
hook_input=""
if [ ! -t 0 ]; then
    hook_input=$(cat || true)
fi

# Extract the SessionStart source (startup|resume|clear|compact). On
# resume/compact the prior context (or its summary) already carries the
# full guide, so we inject only a short reminder to save context.
session_source="startup"
case "$hook_input" in
    *'"source"'*)
        session_source=$(printf '%s' "$hook_input" \
            | sed -n 's/.*"source"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p')
        [ -n "$session_source" ] || session_source="startup"
        ;;
esac

# --- Project Detection ---
# Lightweight checks for FastAPI + Next.js project markers
project_info=""

# FastAPI detection
if [ -f "pyproject.toml" ] && grep -qi "fastapi" pyproject.toml 2>/dev/null; then
    project_info="${project_info}FastAPI backend detected (pyproject.toml). "
elif [ -f "requirements.txt" ] && grep -qi "fastapi" requirements.txt 2>/dev/null; then
    project_info="${project_info}FastAPI backend detected (requirements.txt). "
elif [ -f "src/backend/pyproject.toml" ] && grep -qi "fastapi" src/backend/pyproject.toml 2>/dev/null; then
    project_info="${project_info}FastAPI backend detected (src/backend/). "
fi

# Rust detection (root or one level down, e.g. services/<name>/Cargo.toml)
if [ -f "Cargo.toml" ]; then
    project_info="${project_info}Rust workspace detected (Cargo.toml). "
else
    rust_manifest=$(find . -maxdepth 3 -name Cargo.toml -not -path "*/target/*" -not -path "*/node_modules/*" 2>/dev/null | head -1)
    if [ -n "$rust_manifest" ]; then
        project_info="${project_info}Rust service detected (${rust_manifest#./}). "
    fi
fi

# Next.js detection
if [ -f "package.json" ] && grep -q '"next"' package.json 2>/dev/null; then
    project_info="${project_info}Next.js frontend detected (package.json). "
elif [ -f "src/frontend/package.json" ] && grep -q '"next"' src/frontend/package.json 2>/dev/null; then
    project_info="${project_info}Next.js frontend detected (src/frontend/). "
fi

# Docker detection
if [ -f "docker-compose.yml" ] || [ -f "docker-compose.yaml" ]; then
    project_info="${project_info}Docker infrastructure detected. "
fi

# Constitution detection
constitution_path=$(find_constitution || true)
if [ -n "$constitution_path" ]; then
    project_info="${project_info}Project constitution found at ${constitution_path} — its rules are NORMATIVE for new code (codebase-scanning loads it). "
elif [ -n "$project_info" ]; then
    project_info="${project_info}No project constitution yet (create one with the fullstack-agents:constitution skill). "
fi

# Default message if nothing detected
if [ -z "$project_info" ]; then
    project_info="No FastAPI/Next.js project detected. Fullstack-agents skills are available if needed."
fi

# --- Assemble the context as plain text; hook_context.py encodes it and enforces the hook-size limit ---
PYTHON_BIN=$(find_python || true)
board_session=$(printf '%s' "$hook_input" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
# The session's main agent (Claude Code 2.1 passes agent_type to SessionStart).
agent_type=$(printf '%s' "$hook_input" | sed -n 's/.*"agent_type"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
nl=$'\n'

if [ "$project_info" = "No FastAPI/Next.js project detected. Fullstack-agents skills are available if needed." ]; then
    # Token economy: ungoverned project — a 2-line notice instead of the doctrine. Skills stay invocable on demand.
    essential="fullstack-agents installed but no FastAPI/Rust/Next.js project detected here. If stack work comes up, invoke 'fullstack-agents:using-fullstack-agents' via the Skill tool for the routing gate. For any investigation, plan or change, invoke 'fullstack-agents:task-flow' first."
elif [ "$agent_type" = "fullstack-agents:fullstack-agent" ]; then
    # The lead agent prompt already carries every doctrine rule; repeating it costs context and nothing else.
    essential="**Project Detection:** ${project_info}"
else
    essential="<EXTREMELY_IMPORTANT>${nl}$(cat "${PLUGIN_ROOT}/hooks/session-doctrine.md")${nl}${nl}**Project Detection:** ${project_info}${nl}</EXTREMELY_IMPORTANT>"
fi
# Shared project rules in AGENTS.md reach a Claude lead only through CLAUDE.md; say so when it is not imported.
if [ -f AGENTS.md ] && ! grep -qx '@AGENTS.md' CLAUDE.md 2>/dev/null; then
    essential="${essential}${nl}${nl}**Project rules:** \`AGENTS.md\` holds this repository's rules for every agent and \`CLAUDE.md\` does not import it. Read \`AGENTS.md\` before acting; it is binding."
fi
# The greeting lives only in the project's CLAUDE.md, so a reply that opens with it proves that file loaded.
if [ -n "${FSA_GREETING_NAME:-}" ] && [ -z "${FSA_IMPLEMENTER_RUN:-}" ] &&
    [ "$(git rev-parse --show-toplevel 2>/dev/null)" = "$(pwd -P)" ]; then
    greeting_line="Start each turn's final reply to the user with \`Hi ${FSA_GREETING_NAME},\`."
    if ! grep -qsF "$greeting_line" CLAUDE.md .claude/CLAUDE.md; then
        essential="${essential}${nl}${nl}**CLAUDE.md greeting missing:** append this exact line to the project's \`CLAUDE.md\` (create the file if absent; skip it while another session has uncommitted changes there) and tell the user. It loads from the next session on, so do not open replies with that greeting in this one:${nl}${greeting_line}"
    fi
fi
if [ -n "$PYTHON_BIN" ] && ! cc_hint=$("$PYTHON_BIN" -I "${PLUGIN_ROOT}/scripts/lib/claude_cli.py" 2>&1 >/dev/null); then
    essential="${essential}${nl}${nl}**Claude launcher missing:** ${cc_hint} Tell the user this before any audit, classifier or Claude worker run."
fi
essential="${essential}${nl}${nl}**Plugin scripts:** \`${PLUGIN_ROOT}/scripts\` — \`codex-task.sh\` (Codex dispatch, \`--herdr\` for a visible pane) \`herdr-watch.sh\` (live view of a background worker's transcript) and \`team-board\` (shared claims, locks and notes for the sessions on this repository). The policy profile, when the project sets one, arrives as a separate context block."

# The board is informational and comes last, capped, so it can never push the essential text out of the hook limit.
session_context="$essential"
board_summary=$("${PLUGIN_ROOT}/scripts/team-board" --session "${board_session:-none}" status 2>/dev/null | head -12 || true)
if [ -n "$board_summary" ] && [ "$board_summary" != "board empty" ]; then
    board_cap=${FSA_BOARD_CONTEXT_MAX:-1000}
    if [ "${#board_summary}" -gt "$board_cap" ]; then
        board_summary="${board_summary:0:$board_cap}${nl}... (board truncated; run \`team-board status\` for the rest)"
    fi
    session_context="${session_context}${nl}${nl}**Team board** — other Claude sessions on this repository. Invoke 'fullstack-agents:team-coordination' before a deploy, a default-branch merge, a migration or any shared change:${nl}${board_summary}"
fi

# Session pin: the plugin identity this session started with; dispatches compare against it (scripts/lib/plugin-pin.sh).
# Resume and compact keep the existing pin, so an active task never silently adopts newer plugin code.
if [ -n "$board_session" ] && command -v jq > /dev/null 2>&1; then
    . "${PLUGIN_ROOT}/scripts/lib/plugin-pin.sh"
    pin_file="$(fsa_pin_dir)/session-${board_session}.json"
    loaded_root=$(cd "$PLUGIN_ROOT" && pwd -P)
    stale_release=""
    if [ -s "$pin_file" ] && fsa_release_root "$loaded_root" > /dev/null 2>&1 &&
        [ "$(jq -r '.root // ""' "$pin_file" 2>/dev/null)" != "$loaded_root" ]; then
        # A release is immutable and its hooks already run: a resumed session dispatches through the same release.
        stale_release=$(jq -r '.version // .root' "$pin_file" 2>/dev/null)
    fi
    if [ ! -s "$pin_file" ] || [ "$session_source" = "startup" ] || [ "$session_source" = "clear" ] || [ -n "$stale_release" ]; then
        mkdir -p "$(fsa_pin_dir)" && fsa_plugin_pin "$PLUGIN_ROOT" > "$pin_file" 2>/dev/null || rm -f "$pin_file"
    fi
    if [ -n "$stale_release" ] && [ -s "$pin_file" ]; then
        session_context="${session_context}${nl}${nl}**Plugin pin updated:** this resumed session now dispatches through the loaded release $(jq -r '.version' "$pin_file") (was ${stale_release})."
    fi
    if [ -n "${CLAUDE_ENV_FILE:-}" ] && [ -s "$pin_file" ]; then
        printf 'export FSA_PLUGIN_ROOT=%q FSA_PLUGIN_MODE=%q FSA_SESSION_PIN=%q\n' \
            "$(jq -r .root "$pin_file")" "$(jq -r .mode "$pin_file")" "$pin_file" >> "$CLAUDE_ENV_FILE"
    fi
fi

if [ -n "$PYTHON_BIN" ]; then
    printf '%s' "$session_context" | "$PYTHON_BIN" -I "${PLUGIN_ROOT}/scripts/lib/hook_context.py" emit \
        --event SessionStart --name session-start --session="${board_session:-}" --keep "${#essential}"
elif command -v jq > /dev/null 2>&1; then
    printf '%s' "$session_context" | jq -Rs '{additional_context: ., hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: .}}'
fi

exit 0
