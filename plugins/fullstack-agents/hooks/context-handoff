#!/usr/bin/env bash
# PostToolUse: injects HANDOFF once per compaction cycle when the lead's context passes the checkpoint size.
set -uo pipefail
[ -n "${FSA_IMPLEMENTER_RUN:-}" ] || [ "${FSA_CONTEXT_HANDOFF:-on}" = "off" ] && exit 0
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
source "${SCRIPT_DIR}/lib.sh"
python3 -I "${SCRIPT_DIR}/../scripts/lib/context_handoff.py" "$(state_dir)" 2>/dev/null || true
exit 0
