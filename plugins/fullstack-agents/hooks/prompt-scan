#!/usr/bin/env bash
# prompt-scan — UserPromptSubmit hook: routes every prompt by intent and lane to the skills to invoke.
set -uo pipefail

source "$(dirname "$0")/lib.sh"

HOOK_INPUT="$(cat)"
case "$HOOK_INPUT" in *"SYSTEM NOTIFICATION - NOT USER INPUT"*|*"<task-notification>"*) exit 0 ;; esac
# One interpreter start: route.py parses the hook input and classifies by clause (requested actions only;
# negated clauses become prohibitions; pasted reports and fenced code are context).
mapfile -t ROUTE < <(printf '%s' "$HOOK_INPUT" | python3 -I "$(dirname "$0")/../scripts/lib/route.py" classify --lines 2>/dev/null)
[ "${#ROUTE[@]}" -ge 7 ] || exit 0
intent="${ROUTE[0]}"; lane="${ROUTE[1]}"; prohibited="${ROUTE[2]}"; words="${ROUTE[3]}"
session_id="${ROUTE[5]}"; transcript_path="${ROUTE[6]}"
[ "${words:-0}" -gt 0 ] || exit 0

skill_loaded() { session_has_skill "$transcript_path" "fullstack-agents:$1"; }
lane_core_skill() {
    case "$1" in
        frontend) echo nextjs ;;
        rust)     echo rust-correctness ;;
        infra)    echo docker ;;
        *)        echo "" ;;
    esac
}

# Routing: FSA_ROUTER=auto (default) classifies by clause and calls the Haiku router only when nothing matched and
# the prompt has at least FSA_ROUTER_MIN_WORDS words; FSA_ROUTER=haiku always calls Haiku (about 5 s per prompt);
# FSA_ROUTER=regex never does.
router="${FSA_ROUTER:-auto}"
routed=""
if [ "$router" = "haiku" ]; then
    routed="$(printf '%s' "$HOOK_INPUT" | python3 "$(dirname "$0")/../scripts/fsa-classify" prompt 2>/dev/null)" || routed=""
fi

out_line=""
if [ -n "$routed" ]; then
    out_line="$(printf '%s\n' "$routed" | sed -n 1p)"
    lane="$(printf '%s\n' "$routed" | sed -n 2p)"
else
if [ -z "$intent" ] && [ -z "$lane" ]; then
    [ "$router" = "auto" ] && [ "$words" -ge "${FSA_ROUTER_MIN_WORDS:-6}" ] || exit 0
    routed="$(printf '%s' "$HOOK_INPUT" | python3 "$(dirname "$0")/../scripts/fsa-classify" prompt 2>/dev/null)" || routed=""
    [ -n "$routed" ] || exit 0
    out_line="$(printf '%s\n' "$routed" | sed -n 1p)"
    lane="$(printf '%s\n' "$routed" | sed -n 2p)"
fi

if [ -z "$routed" ]; then
case "$intent" in
    performance) skills="task-flow (Investigate: measure server time vs browser time before any hypothesis), debug" ;;
    investigate) skills="task-flow (Investigate + scan ladder), debug" ;;
    debug)       skills="debug, task-flow" ;;
    plan)        skills="task-flow (Plan), senior-engineer" ;;
    implement)   skills="task-flow (size threshold decides direct edit or delegation), senior-engineer" ;;
    review)      skills="task-flow (Audit), review" ;;
    investigate+implement) skills="task-flow (Investigate first: establish the cause before any change; then the size threshold decides direct edit or delegation), debug" ;;
    question)    skills="none required: answer from the source (grep and bounded reads); load task-flow only if the answer needs an investigation or a change" ;;
    research)    skills="none required: delegate web sources to fullstack-agents:web-researcher (no FILES: block needed) and repository facts to grep; load task-flow only when the research turns into a change" ;;
    deploy)      skills="task-flow (deploy class), the project's deploy rules in CLAUDE.md" ;;
    *)           skills="the lane skill for the code in question" ;;
esac

case "$lane" in
    rust)     lane_skills="rust-correctness plus the rust-* skill for the touched layer (axum-api, sqlx, testing, clean-architecture, nextjs-contract, quality-gates)" ;;
    python)   lane_skills="fastapi or python-clean-architecture; websocket, celery or tasks-management when named" ;;
    infra)    lane_skills="docker" ;;
    frontend) lane_skills="nextjs (read references/data-freshness.md + client-performance.md for tables, fetching, mutations, filters, live data or navigation; live-updates.md for streams), data-table for list pages, fetch-architecture for the fetch layer" ;;
    *)        lane_skills="" ;;
esac
[ "$intent" = "performance" ] && [ "$lane" != "rust" ] && [ "$lane" != "python" ] && [ "$lane" != "infra" ] \
    && project_has_lane frontend && lane_skills="nextjs (read references/client-performance.md, data-freshness.md; live-updates.md for streams), data-table for list pages"

line="[fullstack-agents] intent: ${intent:-general}, lane: ${lane:-any} -> invoke via the Skill tool (fullstack-agents:*): ${skills}"
[ -n "$lane_skills" ] && line="${line}; lane: ${lane_skills} — load these NOW, before the root cause, the plan or any code"
[ -n "$prohibited" ] && line="${line}. Prohibited by the prompt (constraints, not intents): ${prohibited}"
out_line="${line}. Take the cheapest rung that answers it; the conclusion, plan and audit stay yours."
fi
fi

core_skill="$(lane_core_skill "$lane")"
# A lane the repository does not contain gets no "not loaded" nag and no stack doctrine.
if [ -n "$lane" ] && ! project_has_lane "$lane"; then
    core_skill=""
    out_line="$(printf '%s' "$out_line" | sed 's/; lane: .* — load these NOW[^.]*//')"
    lane=""
fi
if [ -n "$core_skill" ]; then
    if skill_loaded "$core_skill"; then
        out_line="$(printf '%s' "$out_line" | sed 's/; lane: .* — load these NOW[^.]*//')"
    else
        out_line="${out_line}
[fullstack-agents] LANE SKILL NOT LOADED THIS SESSION: ${core_skill} — invoke it with the Skill tool before the next brief, edit, plan or conclusion."
    fi
fi
printf '%s\n' "$out_line"

# The full stack doctrine goes in once per session, only when code in a lane is in play.
[ -n "$lane" ] || exit 0
armed_flag=""
[ -n "$session_id" ] && armed_flag="$(state_dir)/armed-${session_id}"
[ -n "$armed_flag" ] && [ -f "$armed_flag" ] && exit 0
[ -n "$armed_flag" ] && touch "$armed_flag"

constitution_line=""
constitution_path=$(find_constitution || true)
if [ -n "$constitution_path" ]; then
    constitution_line="  0. CONSTITUTION: ${constitution_path} is NORMATIVE — its rules override codebase patterns and skill defaults for new code.
"
fi

cat <<CONTEXT
[fullstack-agents] STACK TOPIC DETECTED (lane: ${lane}) — mandatory routing:
${constitution_line}  1. Run the 5-step gate from using-fullstack-agents: DETECT -> MATCH -> REUSE -> INVOKE -> SCAN.
  2. fullstack-agents:codebase-scanning before your first code edit (the pre-edit gate enforces it).
  3. Invoke the matching domain skill as soon as the lane is known — BEFORE any root
     cause, design answer, plan or code — LANGUAGE LANES are strict:
     rust lane -> rust-* skills only; python lane -> fastapi / python-clean-architecture;
     frontend lane -> nextjs / data-table / fetch-architecture. Never blend idioms.
  4. Rust endpoints consumed by Next.js also require fullstack-agents:rust-nextjs-contract.
  5. After code lands: REVIEW PATTERNS -> FIX -> VALIDATE (language-matched chain).
CONTEXT

exit 0
