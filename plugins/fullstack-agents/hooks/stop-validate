#!/usr/bin/env bash
# Stop hook: final validation gate over files THIS session actually edited.
#
# Triggering is session-aware: validation runs only when the turn produced code
# edits (Write/Edit recorded in the per-session manifest). A read-only,
# clarification, or debugging turn edits nothing, so the manifest is empty and
# the hook exits immediately — it never lints a pre-existing dirty tree.
#
# Exit 0  = pass, nothing to check, or tooling unavailable.
# Exit 2  = validation failed; stderr is fed back to Claude, which must fix
#           the failures before the session can end.

set -uo pipefail

source "$(dirname "$0")/lib.sh"

input=$(cat)

# Loop guard: Claude Code sets stop_hook_active when a Stop hook already
# blocked once this cycle — letting it through prevents infinite fix loops.
case "$input" in
    *'"stop_hook_active":true'* | *'"stop_hook_active": true'*) exit 0 ;;
esac

# Files this session edited since the last Stop (consume-once). Empty => the
# turn changed no code => nothing to validate.
session_files=$(consume_touched_files "$(json_get_field "session_id" "$input")")
[ -n "$session_files" ] || exit 0

# Select the session-edited files matching an extension pattern.
changed_files() {
    printf '%s\n' "$session_files" | grep -Ei "$1" 2>/dev/null | sort -u
}

# PATH first, then the project venv via uv, then standalone via uvx
# (still reads the project's [tool.ruff] config).
resolve_ruff() {
    if command -v ruff >/dev/null 2>&1; then
        printf 'ruff'
    elif command -v uv >/dev/null 2>&1; then
        if uv run --quiet ruff --version >/dev/null 2>&1; then
            printf 'uv run --quiet ruff'
        elif uvx ruff --version >/dev/null 2>&1; then
            printf 'uvx ruff'
        fi
    fi
}

# Frontend root for whole-project tsc, matching session-start detection.
detect_frontend_root() {
    if [ -f "package.json" ] && grep -q '"next"' package.json 2>/dev/null; then
        printf '.'
    elif [ -f "src/frontend/package.json" ] && grep -q '"next"' src/frontend/package.json 2>/dev/null; then
        printf 'src/frontend'
    fi
}

errors=""

# --- Python: ruff over modified .py files ---
py_files=$(changed_files '\.py$')
if [ -n "$py_files" ]; then
    ruff_cmd=$(resolve_ruff)
    if [ -n "$ruff_cmd" ]; then
        # shellcheck disable=SC2086
        if ! output=$(printf '%s\n' "$py_files" | tr '\n' '\0' | xargs -0 $ruff_cmd check 2>&1); then
            errors="${errors}[ruff] violations in session-modified Python files:
${output}

"
        fi
    fi
fi

# --- Rust: fmt --check + clippy when session touched .rs files ---
# Walk up from the first modified .rs file to the nearest Cargo.toml.
find_cargo_root() {
    local dir
    dir=$(dirname "$1")
    while [ -n "$dir" ] && [ "$dir" != "/" ] && [ "$dir" != "." ]; do
        if [ -f "$dir/Cargo.toml" ]; then
            printf '%s' "$dir"
            return 0
        fi
        dir=$(dirname "$dir")
    done
    [ -f "Cargo.toml" ] && printf '.'
}

rs_files=$(changed_files '\.rs$')
if [ -n "$rs_files" ] && command -v cargo >/dev/null 2>&1; then
    first_rs=$(printf '%s\n' "$rs_files" | head -1)
    cargo_root=$(find_cargo_root "$first_rs")
    if [ -n "$cargo_root" ]; then
        if ! output=$(cd "$cargo_root" && cargo fmt --all --check 2>&1); then
            errors="${errors}[cargo fmt] unformatted Rust code (run 'cargo fmt --all'):
${output}

"
        fi
        # clippy with deny-warnings (workspace lint policy); fall back to
        # cargo check when clippy is not installed.
        if cargo clippy --version >/dev/null 2>&1; then
            if ! output=$(cd "$cargo_root" && cargo clippy --workspace --all-targets --quiet -- -D warnings 2>&1); then
                errors="${errors}[cargo clippy] warnings/errors after session changes:
$(printf '%s\n' "$output" | tail -40)

"
            fi
        elif ! output=$(cd "$cargo_root" && cargo check --workspace --quiet 2>&1); then
            errors="${errors}[cargo check] compile errors after session changes:
$(printf '%s\n' "$output" | tail -40)

"
        fi
    fi
fi

# --- TypeScript: whole-project tsc when session touched .ts/.tsx files ---
ts_files=$(changed_files '\.tsx?$')
if [ -n "$ts_files" ]; then
    frontend_root=$(detect_frontend_root)
    if [ -n "$frontend_root" ] \
        && [ -f "$frontend_root/tsconfig.json" ] \
        && [ -d "$frontend_root/node_modules" ] \
        && command -v npx >/dev/null 2>&1; then
        if ! output=$(cd "$frontend_root" && npx --no-install tsc --noEmit 2>&1); then
            errors="${errors}[tsc] type errors after session changes:
${output}

"
        fi
    fi
fi

# --- File size: senior-engineer limit on modified code files ---
# The project constitution may override the default via its Limits section.
MAX_FILE_LINES=$(constitution_limit "max-file-lines" 800)
code_files=$(changed_files '\.(py|ts|tsx|rs)$')
if [ -n "$code_files" ]; then
    oversized=""
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        lines=$(wc -l < "$f" 2>/dev/null || echo 0)
        if [ "$lines" -gt "$MAX_FILE_LINES" ]; then
            oversized="${oversized}  ${f}: ${lines} lines
"
        fi
    done <<< "$code_files"
    if [ -n "$oversized" ]; then
        errors="${errors}[file-size] session-modified files exceed ${MAX_FILE_LINES} lines — split into focused modules (senior-engineer discipline):
${oversized}
"
    fi
fi

if [ -n "$errors" ]; then
    {
        echo "[fullstack-agents] Stop blocked — validation failed on session-modified files. Fix these before finishing:"
        printf '%s' "$errors"
    } >&2
    exit 2
fi

exit 0
