#!/usr/bin/env bash
# agent-model — PreToolUse (Agent|Task): a subagent runs on the model the session's agent settings name for it
# (set in the Office, copied from the CTO default when the session started). No setting leaves the call unchanged.
set -uo pipefail

source "$(dirname "$0")/lib.sh"

py=$(find_python || true)
[ -n "$py" ] || exit 0
exec "$py" -I "$(dirname "$0")/../scripts/lib/agent_config.py" hook
