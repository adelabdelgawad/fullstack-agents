#!/usr/bin/env bash
# SessionEnd: a session that exits releases its board claim and locks so peers are never blocked by it.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
hook_input=""
[ ! -t 0 ] && hook_input=$(cat || true)
source "${SCRIPT_DIR}/lib.sh"
json_fields "$hook_input" session_id cwd
session="${JSON_FIELDS[0]}"
cwd="${JSON_FIELDS[1]}"
[ -n "$session" ] || exit 0
[ -n "$cwd" ] && cd "$cwd" 2>/dev/null
"${SCRIPT_DIR}/../scripts/team-board" release-session "$session" >/dev/null 2>&1 || true
python3 -I "${SCRIPT_DIR}/../scripts/lib/task_lifecycle.py" session-end <<<"$hook_input" >/dev/null 2>&1 || true
exit 0
