#!/usr/bin/env bash
# PostToolUse/UserPromptSubmit: injects this session's unread team-board messages; starts Python only after a new send.
set -uo pipefail
[ -n "${FSA_IMPLEMENTER_RUN:-}" ] || [ "${FSA_PEER_INBOX:-on}" = "off" ] && exit 0
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

hook_input=""
[ ! -t 0 ] && hook_input=$(cat || true)
[ -n "$hook_input" ] || exit 0
field() { printf '%s' "$hook_input" | grep -o "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | head -1 | sed 's/^[^:]*:[[:space:]]*"//; s/"$//'; }
[ -z "$(field agent_id)" ] || exit 0
session=$(field session_id)
[ -n "$session" ] || exit 0
event=$(field hook_event_name)
cwd=$(field cwd)

board="${FSA_TEAM_BOARD:-}"
if [ -z "$board" ]; then
    common=$(git -C "${cwd:-.}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
    board="${common}/fsa-team/board.json"
fi
sentinel="${board}.msg"
[ -f "$sentinel" ] || exit 0

source "${SCRIPT_DIR}/lib.sh"
stamp="$(state_dir)/inbox-${session//[^A-Za-z0-9_-]/}.stamp"
[ -f "$stamp" ] && ! [ "$sentinel" -nt "$stamp" ] && exit 0
touch "${stamp}.new" 2>/dev/null || exit 0
"${SCRIPT_DIR}/../scripts/team-board" --board "$board" --session "$session" inbox --hook "${event:-PostToolUse}" 2>/dev/null \
    && mv -f "${stamp}.new" "$stamp"
exit 0
