#!/usr/bin/env bash
# PostToolUse hook (Write|Edit): fast per-file validation of edited Python files.
#
# Exit 0  = pass, skip, or tooling unavailable (never break the session).
# Exit 2  = lint violations found; stderr is fed back to Claude as blocking
#           feedback so the violation is fixed immediately (this is the
#           harness-enforced half of the generate→review→validate chain).
#
# TypeScript files are intentionally NOT checked here: tsc has no fast
# single-file mode, so whole-project tsc runs in the Stop hook instead.

set -uo pipefail

source "$(dirname "$0")/lib.sh"

input=$(cat)

# Resolve a ruff invocation: PATH first, then the project venv via uv,
# then standalone via uvx (still reads the project's [tool.ruff] config).
resolve_ruff() {
    if command -v ruff >/dev/null 2>&1; then
        printf 'ruff'
    elif command -v uv >/dev/null 2>&1; then
        if uv run --quiet ruff --version >/dev/null 2>&1; then
            printf 'uv run --quiet ruff'
        elif uvx ruff --version >/dev/null 2>&1; then
            printf 'uvx ruff'
        fi
    fi
}

file_path=$(json_get_field "tool_input.file_path" "$input")
[ -n "$file_path" ] || exit 0
[ -f "$file_path" ] || exit 0

case "$file_path" in
    *.py)
        ruff_cmd=$(resolve_ruff)
        [ -n "$ruff_cmd" ] || exit 0
        if ! output=$($ruff_cmd check "$file_path" 2>&1); then
            {
                echo "[fullstack-agents] ruff violations in edited file — fix before continuing:"
                printf '%s\n' "$output"
            } >&2
            exit 2
        fi
        ;;
    *.rs)
        # Auto-format (never block here); fmt --check + clippy run in the
        # Stop hook over session-modified files.
        if command -v rustfmt >/dev/null 2>&1; then
            rustfmt --edition 2021 --emit files "$file_path" 2>/dev/null || true
        fi
        ;;
esac

exit 0
