#!/usr/bin/env bash
# auto-phase — keeps a Claude session's dashboard phase current without the lead declaring it.
#   auto-phase prompt  (UserPromptSubmit): a real user prompt after a hand-back (review/complete)
#                      starts a new task, so the card returns to Investigate.
#   auto-phase push    (PostToolUse Bash): a successful `git push` from a finishing branch marks the
#                      session complete, so the card moves to Done. Finishing branches are the
#                      remote's default branch, or FSA_DONE_BRANCHES (comma list) when set.
# Plan, Build and Review are already derived by the dashboard from briefs, runs and edits.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
TB="${SCRIPT_DIR}/../scripts/team-board"
mode="${1:-}"

hook_input=""
[ ! -t 0 ] && hook_input=$(cat || true)
[ -n "$hook_input" ] || exit 0

source "${SCRIPT_DIR}/lib.sh"
json_fields "$hook_input" session_id cwd prompt tool_input.command tool_response.interrupted tool_response.stderr tool_response.stdout
session="${JSON_FIELDS[0]}"
cwd="${JSON_FIELDS[1]}"
[ -n "$session" ] || exit 0
[ -n "$cwd" ] && { cd "$cwd" 2>/dev/null || exit 0; }
git rev-parse --git-dir >/dev/null 2>&1 || exit 0

case "$mode" in
prompt)
    prompt="${JSON_FIELDS[2]}"
    [ -n "$prompt" ] || exit 0
    case "$prompt" in *"SYSTEM NOTIFICATION - NOT USER INPUT"*|*"<task-notification>"*) exit 0 ;; esac
    python3 "$TB" --session "$session" phase investigate --only-from review,complete \
        --note "new request after hand-back" >/dev/null 2>&1
    ;;
push)
    command="${JSON_FIELDS[3]}"
    printf '%s' "$command" | grep -qE '(^|[;&|[:space:]])git([[:space:]]+-[^[:space:]]+([[:space:]]+[^-[:space:]][^[:space:]]*)?)*[[:space:]]+push([[:space:]]|$)' || exit 0
    printf '%s' "$command" | grep -qE -- '--dry-run|(^|[[:space:]])-n([[:space:]]|$)|--delete' && exit 0
    [ "${JSON_FIELDS[4]}" = "true" ] && exit 0
    output="${JSON_FIELDS[5]}
${JSON_FIELDS[6]}"
    printf '%s' "$output" | grep -qiE '\[rejected\]|^error:|^fatal:|failed to push' && exit 0
    branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || exit 0
    if [ -n "${FSA_DONE_BRANCHES:-}" ]; then
        done_branches="$FSA_DONE_BRANCHES"
    else
        done_branches=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')
        [ -n "$done_branches" ] || done_branches="main,master"
    fi
    case ",${done_branches// /}," in *",${branch},"*) ;; *) exit 0 ;; esac
    head=$(git rev-parse --short HEAD 2>/dev/null)
    python3 "$TB" --session "$session" phase complete --note "pushed ${branch} at ${head}" >/dev/null 2>&1
    ;;
esac
exit 0
