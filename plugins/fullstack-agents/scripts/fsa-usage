#!/usr/bin/env python3
"""Print the current session's context fill, compactions and estimated cost from its transcript."""
import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from plan_usage import plan_usage
from usage import session_usage

HANDOFF_FILL = 0.85
BASES = (os.environ.get("CLAUDE_CONFIG_DIR"), "~/.claude", "~/.claude-anthropic")


def transcript(sid):
    for base in dict.fromkeys(b for b in BASES if b):
        hits = sorted(Path(base).expanduser().glob(f"projects/*/{sid}.jsonl"), key=lambda p: p.stat().st_mtime)
        if hits:
            return hits[-1]
    return None


def money(c):
    return "unpriced" if c is None else f"${c:.2f}"


def main():
    ap = argparse.ArgumentParser(prog="fsa-usage")
    ap.add_argument("--session", default=os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("CLAUDE_SESSION_ID"))
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()
    if not args.session:
        sys.exit("fsa-usage: no session id (set CLAUDE_CODE_SESSION_ID or pass --session)")
    path = transcript(args.session)
    u = session_usage(path) if path else None
    if not u:
        sys.exit(f"fsa-usage: no transcript for session {args.session}")
    if args.json:
        print(json.dumps(u))
        return
    print(f"context {round(u['fill'] * 100)}% ({u['context']:,}/{u['window']:,}) · compactions {u['compactions']} · "
          f"est. cost {money(u['total_cost'])} (lead {money(u['cost'])}, subagents {money(u['agent_cost']) if u['agents'] else 'none'}) · "
          f"tokens {u['tokens'] + u['agent_tokens']:,} · model {u['model']}")
    for name, p in plan_usage(wait=True).items():
        if p.get("spend"):
            print(f"{name}: " + " · ".join(f"{x['name']} {x['tokens']:,} tokens ${x['cost']:.2f}" for x in p["spend"]) + " (no plan limits reported)")
        if p.get("windows"):
            pct = lambda w: "reset" if w["pct"] is None else f"{round(w['pct'])}%"
            credits = f" · credits {round(p['credits']['balance']):,} left" if p.get("credits") else ""
            print(f"{name} plan: " + " · ".join(f"{w['name']} {pct(w)}" for w in p["windows"]) + credits + (f" ({p['stale']})" if p.get("stale") else ""))
    if u["fill"] >= HANDOFF_FILL:
        print(f"HANDOFF: context is at {round(u['fill'] * 100)}%; write the handoff or compact before the next large step")


if __name__ == "__main__":
    main()
