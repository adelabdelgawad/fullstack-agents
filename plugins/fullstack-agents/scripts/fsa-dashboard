def run_herdr(*args, timeout=5):
    command = shutil.which("herdr")
    if not command:
        return None
    try:
        return subprocess.run([command, *args], capture_output=True, timeout=timeout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def normalize_herdr_snapshot(raw):
    snap = raw["result"]["snapshot"]
    return {
        "running": True,
        "workspaces": [{k: x.get(k) for k in ("workspace_id", "label")} for x in snap.get("workspaces", [])],
        "tabs": [{k: x.get(k) for k in ("tab_id", "workspace_id", "label", "number", "agent_status")} for x in snap.get("tabs", [])],
        "panes": [{
            "pane_id": x.get("pane_id"), "tab_id": x.get("tab_id"), "workspace_id": x.get("workspace_id"),
            "title": x.get("terminal_title_stripped") or "", "status": x.get("agent_status") or "unknown",
            "cwd": x.get("cwd") or "", "agent": x.get("agent") or "",
            "agent_session": x.get("agent_session"),
        } for x in snap.get("panes", [])],
        "focused_pane_id": snap.get("focused_pane_id"),
        "agent_kinds": list(HERDR_AGENT_KINDS),
    }


def read_herdr_snapshot():
    result = run_herdr("api", "snapshot")
    if result is None or result.returncode:
        return {"running": False, "workspaces": [], "tabs": [], "panes": [], "focused_pane_id": None,
                "agent_kinds": list(HERDR_AGENT_KINDS)}
    try:
        return normalize_herdr_snapshot(json.loads(result.stdout))
    except (KeyError, TypeError, ValueError):
        return {"running": False, "workspaces": [], "tabs": [], "panes": [], "focused_pane_id": None,
                "agent_kinds": list(HERDR_AGENT_KINDS)}


def herdr_screen(pane, source):
    args = ["pane", "read", pane, "--source", source, "--format", "ansi"]
    if source == "recent":
        args += ["--lines", "1000"]
    result = run_herdr(*args)
    return result.stdout if result is not None and result.returncode == 0 else None


def herdr_send_args(body, pane_ids):
    if not isinstance(body, dict):
        raise TypeError("body must be an object")
    pane, kind = body.get("pane"), body.get("kind")
    if pane not in pane_ids:
        raise LookupError("unknown pane")
    if kind in ("prompt", "text"):
        text = body.get("text")
        if not isinstance(text, str) or not 1 <= len(text) <= 8000 or "\x00" in text:
            raise ValueError("bad text")
        return ["agent", "prompt", pane, text] if kind == "prompt" else ["pane", "send-text", pane, text]
    if kind == "keys":
        keys = body.get("keys")
        if not isinstance(keys, list) or not 1 <= len(keys) <= 10 or any(not isinstance(k, str) or k not in HERDR_KEYS for k in keys):
            raise ValueError("bad keys")
        return ["pane", "send-keys", pane, *keys]
    raise ValueError("bad kind")


def has_nul(value):
    if isinstance(value, str):
        return "\x00" in value
    if isinstance(value, list):
        return any(has_nul(x) for x in value)
    if isinstance(value, dict):
        return any(has_nul(k) or has_nul(v) for k, v in value.items())
    return False


def herdr_live_command(body):
    if not isinstance(body, dict) or has_nul(body):
        raise TypeError("body must be an object without NULs")
    session, kind = body.get("session"), body.get("type")
    if not isinstance(session, str) or not session:
        raise ValueError("bad session")
    if kind == "input":
        if set(body) != {"session", "type", "bytes"} or not isinstance(body.get("bytes"), str):
            raise ValueError("bad input")
        try:
            decoded = base64.b64decode(body["bytes"], validate=True)
        except (binascii.Error, ValueError):
            raise ValueError("bad input") from None
        if not 1 <= len(decoded) <= 65536:
            raise ValueError("bad input")
        return {"type": "terminal.input", "bytes": body["bytes"]}
    if kind == "resize":
        if set(body) != {"session", "type", "cols", "rows"}:
            raise ValueError("bad resize")
        cols, rows = body["cols"], body["rows"]
        if isinstance(cols, bool) or isinstance(rows, bool) or not isinstance(cols, int) or not isinstance(rows, int) \
                or not 10 <= cols <= 500 or not 5 <= rows <= 200:
            raise ValueError("bad resize")
        return {"type": "terminal.resize", "cols": cols, "rows": rows}
    if kind == "scroll":
        if set(body) != {"session", "type", "direction", "lines"}:
            raise ValueError("bad scroll")
        direction, lines = body["direction"], body["lines"]
        if direction not in ("up", "down") or isinstance(lines, bool) or not isinstance(lines, int) \
                or not 1 <= lines <= 100:
            raise ValueError("bad scroll")
        return {"type": "terminal.scroll", "direction": direction, "lines": lines}
    raise ValueError("bad type")


class HerdrLiveSession:
    def __init__(self, process):
        self.process = process
        self.write_lock = threading.Lock()
        self.error_lock = threading.Lock()
        self.stopped = threading.Event()
        self.error_done = threading.Event()
        self.output = queue.Queue(maxsize=64)
        self.error = bytearray()
        os.set_blocking(self.process.stdin.fileno(), False)
        threading.Thread(target=self._read_output, daemon=True).start()
        threading.Thread(target=self._read_error, daemon=True).start()

    def _queue_output(self, line):
        while not self.stopped.is_set():
            try:
                self.output.put(line, timeout=0.1)
                return
            except queue.Full:
                pass

    def _read_output(self):
        try:
            for line in iter(self.process.stdout.readline, b""):
                self._queue_output(line.rstrip(b"\r\n"))
                if self.stopped.is_set():
                    return
        except (OSError, ValueError):
            pass
        finally:
            self._queue_output(None)

    def _read_error(self):
        try:
            for chunk in iter(lambda: self.process.stderr.read(4096), b""):
                with self.error_lock:
                    self.error.extend(chunk)
                    if len(self.error) > 8192:
                        del self.error[:-8192]
        except (OSError, ValueError):
            pass
        finally:
            self.error_done.set()

    def error_text(self):
        with self.error_lock:
            return bytes(self.error).decode("utf-8", "replace").strip()

    def wait_for_error(self, timeout):
        self.error_done.wait(timeout)

    def write(self, command, timeout=0.25):
        data = json.dumps(command, separators=(",", ":")).encode() + b"\n"
        deadline = time.monotonic() + timeout
        if not self.write_lock.acquire(timeout=timeout):
            raise TimeoutError("terminal input is busy")
        try:
            fd = self.process.stdin.fileno()
            view = memoryview(data)
            while view:
                try:
                    written = os.write(fd, view)
                except BlockingIOError:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0 or not select.select([], [fd], [], remaining)[1]:
                        raise TimeoutError("terminal input timed out")
                    continue
                if not written:
                    raise BrokenPipeError("terminal input closed")
                view = view[written:]
        finally:
            self.write_lock.release()

    def release(self):
        try:
            if self.process.poll() is None:
                try:
                    self.write({"type": "terminal.release"}, timeout=0.1)
                except (BrokenPipeError, OSError, ValueError):
                    pass
                try:
                    self.process.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    try:
                        self.process.kill()
                    except OSError:
                        pass
                    try:
                        self.process.wait(timeout=2)
                    except subprocess.TimeoutExpired:
                        pass
        finally:
            self.stopped.set()
            self.error_done.wait(2)
            for pipe in (self.process.stdin, self.process.stdout, self.process.stderr):
                try:
                    pipe.close()
                except (OSError, ValueError):
                    pass


def herdr_label(value):
    if not isinstance(value, str) or not 1 <= len(value) <= 80 or value.startswith("-") \
            or any(unicodedata.category(c) == "Cc" for c in value):
        raise ValueError("bad label")
    return value


def herdr_action_args(body, snapshot):
    if not isinstance(body, dict) or has_nul(body):
        raise TypeError("body must be an object without NULs")
    action = body.get("action")
    fields = {
        "workspace.create": (set(), {"label", "cwd"}),
        "workspace.rename": ({"workspace_id", "label"}, set()),
        "workspace.close": ({"workspace_id"}, set()),
        "tab.create": ({"workspace_id"}, {"label"}),
        "session.create": ({"workspace_id", "name"}, {"engine"}),
        "tab.rename": ({"tab_id", "label"}, set()),
        "tab.close": ({"tab_id"}, set()),
        "pane.rename": ({"pane_id", "label"}, set()),
        "pane.clear_name": ({"pane_id"}, set()),
        "pane.split": ({"pane_id", "direction"}, set()),
        "pane.zoom": ({"pane_id"}, set()),
        "pane.swap": ({"source_pane_id", "target_pane_id"}, set()),
        "pane.close": ({"pane_id"}, set()),
        "agent.start": ({"pane_id", "kind", "name"}, set()),
        "server.reload_config": (set(), set()),
    }
    if action not in fields:
        raise ValueError("bad action")
    required, optional = fields[action]
    keys = set(body) - {"action"}
    if not required <= keys or not keys <= required | optional:
        raise ValueError("bad fields")

    ids = {
        "workspace_id": {x.get("workspace_id") for x in snapshot.get("workspaces", [])},
        "tab_id": {x.get("tab_id") for x in snapshot.get("tabs", [])},
        "pane_id": {x.get("pane_id") for x in snapshot.get("panes", [])},
    }

    def checked_id(field, kind=None):
        value = body.get(field)
        if not isinstance(value, str) or not value:
            raise ValueError("bad id")
        if value not in ids[kind or field.removeprefix("source_").removeprefix("target_")]:
            raise LookupError("unknown id")
        return value

    if action == "workspace.create":
        args = ["workspace", "create"]
        if "cwd" not in body:
            focused = snapshot.get("focused_pane_id")
            cwd = next((x.get("cwd") for x in snapshot.get("panes", []) if x.get("pane_id") == focused), None)
            cwd = cwd if isinstance(cwd, str) and os.path.isabs(cwd) and os.path.isdir(cwd) else None
        else:
            cwd = body["cwd"]
            if not isinstance(cwd, str) or not os.path.isabs(cwd) or not os.path.isdir(cwd):
                raise ValueError("bad cwd")
        if cwd is not None:
            args.extend(("--cwd", cwd))
        if "label" in body:
            args.extend(("--label", herdr_label(body["label"])))
        return [*args, "--no-focus"], 5
    if action.startswith("workspace."):
        workspace = checked_id("workspace_id")
        if action == "workspace.rename":
            return ["workspace", "rename", workspace, herdr_label(body["label"])], 5
        return ["workspace", "close", workspace], 5
    if action == "tab.create":
        args = ["tab", "create", "--workspace", checked_id("workspace_id")]
        if "label" in body:
            args.extend(("--label", herdr_label(body["label"])))
        return [*args, "--no-focus"], 5
    if action == "session.create":
        if body.get("engine", "claude") not in SESSION_ENGINES:
            raise ValueError("bad engine")
        return ["tab", "create", "--workspace", checked_id("workspace_id"), "--label", herdr_label(body["name"]), "--no-focus"], 5
    if action.startswith("tab."):
        tab = checked_id("tab_id")
        if action == "tab.rename":
            return ["tab", "rename", tab, herdr_label(body["label"])], 5
        return ["tab", "close", tab], 5
    if action == "server.reload_config":
        return ["server", "reload-config"], 5
    if action == "pane.swap":
        source = checked_id("source_pane_id", "pane_id")
        target = checked_id("target_pane_id", "pane_id")
        if source == target:
            raise ValueError("panes must differ")
        return ["pane", "swap", "--source-pane", source, "--target-pane", target], 5

    pane = checked_id("pane_id")
    if action == "pane.rename":
        return ["pane", "rename", pane, herdr_label(body["label"])], 5
    if action == "pane.clear_name":
        return ["pane", "rename", pane, "--clear"], 5
    if action == "pane.split":
        direction = body["direction"]
        if direction not in ("right", "down"):
            raise ValueError("bad direction")
        return ["pane", "split", "--pane", pane, "--direction", direction], 5
    if action == "pane.zoom":
        return ["pane", "zoom", "--pane", pane, "--toggle"], 5
    if action == "pane.close":
        return ["pane", "close", pane], 5
    kind = body["kind"]
    if kind not in HERDR_AGENT_KINDS:
        raise ValueError("bad agent kind")
    return ["agent", "start", herdr_label(body["name"]), "--kind", kind, "--pane", pane,
            "--timeout", "30000"], 40


SESSION_ENGINES = {
    "claude": lambda name: f"cc -n {shlex.quote(name)}",
    "codex": lambda name: "codex",
    "grok": lambda name: "opencode -m xai/grok-4.7",
}


def start_session(created, name, engine="claude"):
    pane = ((created or {}).get("root_pane") or {}).get("pane_id")
    if not isinstance(pane, str) or not pane:
        return None
    typed = run_herdr("pane", "send-text", pane, SESSION_ENGINES[engine](name))
    return run_herdr("pane", "send-keys", pane, "enter") if typed is not None and typed.returncode == 0 else typed


def load_json(path):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return None


def git_env():
    return dict(os.environ, GIT_OPTIONAL_LOCKS="0")


def git(cwd, *args):
    try:
        r = subprocess.run(["git", "--no-optional-locks", "-C", str(cwd), *args],
                           capture_output=True, text=True, timeout=15, env=git_env())
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout if r.returncode == 0 else None


def tail_lines(path, size=TAIL_BYTES):
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            end = f.tell()
            f.seek(max(0, end - size))
            data = f.read().decode("utf-8", "replace")
    except OSError:
        return []
    lines = data.splitlines()
    return lines[1:] if end > size else lines


def message_tail(path):
    """A transcript tail widened (up to SESSION_TAIL_MAX) until it holds a conversation line."""
    size = TAIL_BYTES
    while True:
        lines = tail_lines(path, size)
        if size >= SESSION_TAIL_MAX or any('"type":"user"' in x or '"type":"assistant"' in x for x in lines):
            return lines
        try:
            if path.stat().st_size <= size:
                return lines
        except OSError:
            return lines
        size *= 4


def encode_project(path):
    return re.sub(r"[^A-Za-z0-9-]", "-", str(path))


class Repo:
    def __init__(self, repo, runs, projects):
        common = (git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir") or "").strip()
        if not common:
            sys.exit(f"fsa-dashboard: {repo} is not a git repository")
        self.common = Path(common)
        self.root = self.common.parent if self.common.name == ".git" else Path(repo).resolve()
        self.state = self.common / "fsa-team"
        self.state.mkdir(exist_ok=True)
        self.board = self.state / "board.json"
        self.favourites = self.state / "dashboard-favourites.json"
        self.runs = runs_dir(self.root, runs, self.binding_runs())
        self.run_dirs = read_dirs(self.root, self.runs)
        bases = projects or CLAUDE_BASES
        self.projects = list(dict.fromkeys(Path(b).expanduser() / "projects" for b in bases if b))
        head = (git(self.root, "symbolic-ref", "--short", "refs/remotes/origin/HEAD") or "").strip()
        self.main = head.split("/", 1)[1] if "/" in head else "main"

    def binding_runs(self):
        try:
            text = (self.root / "scripts" / "codex-task.sh").read_text()
        except OSError:
            return None
        m = re.search(r'FSA_CODEX_RUNS_DIR="?([^"\n]+)"?', text)
        return os.path.expandvars(m.group(1)) if m else None

    def run_home(self, rid):
        return next((d for d in self.run_dirs if (d / f"{rid}.meta.json").exists()), self.runs)


def newest_edit(path, status):
    names = [line[3:].split(" -> ")[-1] for line in status.splitlines()]
    names += (git(path, "ls-files", "--others", "--exclude-standard") or "").splitlines()
    newest = 0.0
    for name in names[:400]:
        try:
            newest = max(newest, os.stat(os.path.join(path, name)).st_mtime)
        except OSError:
            pass
    return newest


class GitCache:
    def __init__(self, repo):
        self.repo = repo
        self.at = 0.0
        self.trees = {}
        self.details = {}

    def worktrees(self, now):
        if now - self.at > GIT_TTL_S:
            self.at, self.details = now, {}
            self.main_sha = (git(self.repo.root, "rev-parse", self.repo.main) or "").strip() or self.repo.main
            self.trees = {}
            cur = {}
            for line in (git(self.repo.root, "worktree", "list", "--porcelain") or "").splitlines() + [""]:
                if not line:
                    if cur.get("path"):
                        self.trees[cur["path"]] = cur
                    cur = {}
                elif line.startswith("worktree "):
                    cur["path"] = line[9:]
                elif line.startswith("HEAD "):
                    cur["head"] = line[5:]
                elif line.startswith("branch "):
                    cur["branch"] = line[7:].removeprefix("refs/heads/")
        return self.trees

    def detail(self, path):
        if path not in self.details:
            tree = self.trees.get(path, {})
            head = tree.get("head", "")
            main = self.main_sha
            status = git(path, "status", "--porcelain", "-uno") or ""
            ahead = (git(self.repo.root, "rev-list", "--count", f"{main}..{head}") or "0").strip() if head else "0"
            fresh = self.fresh(tree.get("branch"))
            self.details[path] = {
                "branch": tree.get("branch") or "detached",
                "head": head,
                "fresh": fresh,
                "ahead": int(ahead or 0),
                "dirty": len(status.splitlines()),
                "edited": newest_edit(path, status),
            }
        return self.details[path]

    def fresh(self, branch):
        if not branch:
            return False
        log = git(self.repo.root, "reflog", "show", "--format=%gs", f"refs/heads/{branch}") or ""
        entries = log.splitlines()
        return len(entries) == 1 and entries[0].startswith("branch: Created from")


def run_root(runs, rid, meta):
    if meta.get("root"):
        return meta["root"]
    try:
        m = ROOT_RE.search((runs / f"{rid}.runner.sh").read_text())
    except OSError:
        return None
    return m.group(1) if m else None


def goal_line(path, limit=220):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                if line.startswith("GOAL:"):
                    return line[5:].strip()[:limit]
    except OSError:
        pass
    return ""


def brief_header(path):
    goal, tree = "", ""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for _, line in zip(range(40), f):
                if line.startswith("GOAL:"):
                    goal = line[5:].strip()[:900]
                elif line.startswith("TREE:"):
                    tree = next((w for w in line[5:].split() if w.startswith("/")), "")
    except OSError:
        pass
    return goal, tree


def newest_brief(repo, stems, key):
    best = None
    for stem in stems:
        path = repo.root / ".codex-briefs" / f"{stem}.md"
        try:
            at = path.stat().st_mtime
        except OSError:
            continue
        goal, tree = brief_header(path)
        if goal and (not tree or tree == key) and (best is None or at > best[0]):
            best = (at, goal)
    return best


def pid_alive(pid):
    try:
        return b"codex-task" in Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return False


def touched_paths(runs, rid):
    try:
        pre = set((runs / f"{rid}.pre.txt").read_text().splitlines())
        post = set((runs / f"{rid}.post.txt").read_text().splitlines())
    except OSError:
        return None
    return sorted({line.split(" ", 1)[-1] for line in pre ^ post})


def status_files(root):
    out = []
    for line in (git(root, "status", "--porcelain", "-uall") or "").splitlines()[:MAX_FILES]:
        code = line[:2].strip() or "?"
        out.append({"status": "?" if code == "??" else code[:1], "path": line[3:].split(" -> ")[-1].strip('"')})
    return out


def scoped_files(repo, root, scope, files):
    own = card_scope(repo, root, scope, files)
    return sorted(({**f, "own": f["path"] in own} for f in files), key=lambda f: not f["own"])


def own_newest_edit(repo, root, scope, now):
    """Newest mtime among the changed files this card's sessions and runs touched."""
    key = (root, json.dumps(scope, sort_keys=True))
    hit = OWN_EDIT_CACHE.get(key)
    if hit and now - hit[0] < GIT_TTL_S:
        return hit[1]
    newest = 0.0
    for f in scoped_files(repo, root, scope, status_files(root)):
        if f["own"]:
            try:
                newest = max(newest, os.stat(os.path.join(root, f["path"])).st_mtime)
            except OSError:
                pass
    OWN_EDIT_CACHE[key] = (now, newest)
    return newest


def own_count(repo, root, scope, now):
    hit = OWN_CACHE.get(root)
    if hit and now - hit[0] < GIT_TTL_S and hit[1] == scope:
        return hit[2]
    n = sum(f["own"] for f in scoped_files(repo, root, scope, status_files(root)))
    OWN_CACHE[root] = (now, scope, n)
    return n


def commit_files(root, sha):
    out = []
    for line in (git(root, "show", "--name-status", "--format=", "-M", sha) or "").splitlines()[:MAX_FILES]:
        cols = line.split("\t")
        if len(cols) >= 2:
            out.append({"status": cols[0][:1], "path": cols[-1]})
    return out


def change_items(root, main):
    ahead = int((git(root, "rev-list", "--count", f"{main}..HEAD") or "0").strip() or 0)
    own = set() if ahead else branch_subjects(root)
    args = ["log", "--no-color", "--format=%h\t%s\t%at", "-n", "60" if ahead else "1000"] + ([f"{main}..HEAD"] if ahead else [])
    commits = []
    for line in (git(root, *args) or "").splitlines() if ahead or own else []:
        sha, subject, at = (line.split("\t") + ["", "0"])[:3]
        if ahead or subject in own:
            own.discard(subject)
            commits.append({"sha": sha, "subject": subject, "at": int(at or 0)})
    return {"ahead": ahead, "recent": not ahead, "dirty": len(status_files(root)), "commits": commits[:60]}


def branch_subjects(root):
    branch = (git(root, "symbolic-ref", "--short", "-q", "HEAD") or "").strip()
    log = git(root, "reflog", "show", "--format=%gs", f"refs/heads/{branch}") if branch else ""
    return {m.group(1) for m in map(BRANCH_COMMIT_RE.match, (log or "").splitlines()) if m}


def ref_diff(root, ref, path):
    if ref == WORKTREE_REF:
        out = git(root, "diff", "--no-color", "--no-ext-diff", "HEAD", "--", path) or ""
        if not out.strip():
            try:
                out = subprocess.run(["git", "--no-optional-locks", "-C", str(root), "diff", "--no-color", "--no-index", "--", "/dev/null", path],
                                     capture_output=True, text=True, timeout=15, env=git_env()).stdout
            except (OSError, subprocess.SubprocessError):
                out = ""
    else:
        out = git(root, "show", "--no-color", "--no-ext-diff", "--format=", "-M", ref, "--", path) or ""
    out = out.strip("\n")
    if not out:
        return "(no textual changes: binary file, mode change or empty file)"
    return out[:MAX_DIFF] + ("\n... diff truncated" if len(out) > MAX_DIFF else "")


def run_started(rid, meta):
    at = iso_epoch(meta.get("started", ""))
    if at:
        return at
    parts = rid.split("-")
    try:
        return datetime.strptime(parts[1] + parts[2], "%Y%m%d%H%M%S").replace(tzinfo=timezone.utc).timestamp()
    except (IndexError, ValueError):
        return 0


def run_window(runs, rid):
    try:
        start = (runs / f"{rid}.pre.txt").stat().st_mtime
    except OSError:
        return None
    try:
        return start, (runs / f"{rid}.post.txt").stat().st_mtime
    except OSError:
        return start, time.time()


def read_allow(runs, rid):
    try:
        return set((runs / f"{rid}.allow").read_text().split())
    except OSError:
        return set()


LEAD_EDIT_TOOLS = ("Edit", "Write", "MultiEdit", "NotebookEdit")
OUTSIDE_CACHE = {}
EDIT_CACHE = {}
FRESH_NOTE = "New session: send the first message"
OWN_CACHE = {}
OWN_EDIT_CACHE = {}
BRANCH_COMMIT_RE = re.compile(r"^(?:commit(?: \(amend\)| \(initial\))?|cherry-pick): (.*)$")
SHELL_PREFIX = "\0bash:"
SHELL_WRITE_RE = re.compile(r"(?<![0-9&])>>?\s*[^&\s>]|\btee\b|\bsed\s+-i|\bperl\s+-i|\.write\(|write_text\(|\b(?:mv|cp|rm|touch)\s")


def session_transcript(projects, session):
    for base in projects if session else []:
        for path in base.glob(f"*/{session}.jsonl"):
            return path
    return None


def session_edits(projects, session):
    path = session_transcript(projects, session)
    try:
        size = path.stat().st_size if path else -1
    except OSError:
        size = -1
    if size < 0:
        return []
    hit = EDIT_CACHE.get(path)
    if hit and hit[0] == size:
        return hit[1]
    out = []
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            if '"tool_use"' not in line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if d.get("type") != "assistant":
                continue
            at = iso_epoch(d.get("timestamp") or "")
            for b in (d.get("message") or {}).get("content") or []:
                if not isinstance(b, dict) or b.get("type") != "tool_use":
                    continue
                if b.get("name") in LEAD_EDIT_TOOLS:
                    target = (b.get("input") or {}).get("file_path") or (b.get("input") or {}).get("notebook_path") or ""
                    if target:
                        out.append((at, target))
                elif b.get("name") == "Bash":
                    cmd = str((b.get("input") or {}).get("command") or "")
                    if SHELL_WRITE_RE.search(cmd):
                        out.append((at, SHELL_PREFIX + cmd))
    EDIT_CACHE[path] = (size, out)
    return out


def under(root, targets):
    return {t[len(root) + 1:] for t in targets if t.startswith(root + "/")}


def lead_edits(projects, session, root, window):
    if not window or not root:
        return set()
    return under(root, (t for at, t in session_edits(projects, session) if window[0] <= at <= window[1]))


def card_scope(repo, root, scope, files):
    own, shell = set(), []
    for rid in scope["runs"]:
        home = repo.run_home(rid)
        own |= read_allow(home, rid) or set(touched_paths(home, rid) or [])
        brief = (load_json(home / f"{rid}.meta.json") or {}).get("brief", "")
        own |= under(root, [brief])
    for sid in scope["sessions"]:
        edits = [t for _, t in session_edits(repo.projects, sid)]
        own |= under(root, edits)
        shell += [t[len(SHELL_PREFIX):] for t in edits if t.startswith(SHELL_PREFIX)]
    named = lambda p, cmd: p in cmd or root in cmd and p.rsplit("/", 1)[-1] in cmd
    return own | {f["path"] for f in files if any(named(f["path"], cmd) for cmd in shell)}


def claimed_paths(runs, rid, meta, projects, others=()):
    root, mine = meta.get("root", ""), run_window(runs, rid)
    claimed = read_allow(runs, rid)
    if not claimed:
        return {p for p in touched_paths(runs, rid) or []}
    for allow in (a for d in dict.fromkeys([runs, *others]) for a in d.glob("implement-*.allow")):
        oid, home = allow.name[:-len(".allow")], allow.parent
        other = run_window(home, oid)
        if oid == rid or not other or not mine or other[0] > mine[1] or other[1] < mine[0]:
            continue
        if (load_json(home / f"{oid}.meta.json") or {}).get("root") == root:
            claimed |= read_allow(home, oid)
    claimed |= lead_edits(projects, meta.get("session", ""), root, mine)
    brief = meta.get("brief", "")
    prefix = os.path.relpath(os.path.dirname(brief), root) + "/" if brief and root else None
    return claimed | {p for p in touched_paths(runs, rid) or [] if prefix and p.startswith(prefix)}


def fix_target(units, i):
    unit = units[i]
    if "-fix" not in unit:
        return None
    base = unit[:unit.index("-fix")]
    return next((j for j in range(i - 1, -1, -1) if units[j] == base or units[j].startswith(base + "-")), None)


def round_list(impl):
    units = [r["unit"] for r in impl]
    sent_back = {fix_target(units, i) for i in range(len(units))} - {None}
    return [{k: r[k] for k in ("id", "unit", "engine", "model", "state", "flags", "started", "updated")} | {"sent_back": i in sent_back}
            for i, r in enumerate(impl)]


def fix_depth(units):
    depth, i = 1, len(units) - 1
    while i is not None and (i := fix_target(units, i)) is not None:
        depth += 1
    return depth


def read_run(runs, rid, log_mtime, now, projects, others=()):
    mode = rid.split("-", 1)[0]
    meta = load_json(runs / f"{rid}.meta.json") or {}
    brief = meta.get("brief") or ""
    unit = Path(brief).stem if brief else ""
    last = runs / f"{rid}.last.txt"
    result = None
    if last.exists() and last.stat().st_size:
        result = load_json(last) or {"summary": last.read_text(errors="replace")[:2000]}
    live = liveness.run_state(runs, rid)["state"] if not result and meta.get("schema", 1) >= 2 else "legacy"
    if result:
        state = "done"
    elif live == "running":
        state = "stalled" if now - log_mtime > STALL_S else "running"
    elif live == "uncertain":
        state = "stalled"
    elif live == "stopped":
        state = "abandoned" if now - log_mtime > ABANDON_S else "failed"
    elif pid_alive(rid.rsplit("-", 1)[-1]):
        state = "stalled" if now - log_mtime > STALL_S else "running"
    else:
        state = "abandoned" if now - log_mtime > ABANDON_S else "failed"
    touched = touched_paths(runs, rid) if mode == "implement" else None
    flags, outside = [], []
    if state in ("failed", "stalled"):
        flags.append(state)
    if live == "uncertain":
        flags.append("uncertain")
    if state == "done" and touched is not None:
        recorded = runs / f"{rid}.outside"
        if recorded.exists():
            outside = recorded.read_text().split()
        else:
            if rid not in OUTSIDE_CACHE:
                OUTSIDE_CACHE[rid] = sorted(set(touched) - claimed_paths(runs, rid, meta, projects, others))
            outside = OUTSIDE_CACHE[rid]
        if outside:
            flags.append("out_of_scope")
        if not touched:
            flags.append("no_changes")
    return {
        "id": rid, "mode": mode, "engine": meta.get("engine", ""), "model": meta.get("model", ""), "unit": unit,
        "session": meta.get("session", ""),
        "root": run_root(runs, rid, meta), "goal": goal_line(runs / f"{rid}.prompt.md"),
        "desc": goal_line(runs / f"{rid}.prompt.md", 900),
        "state": state, "flags": flags, "updated": log_mtime, "started": run_started(rid, meta),
        "touched": touched or [], "outside": outside, "open_risks": (result or {}).get("open_risks", []),
        "allowed": sorted(read_allow(runs, rid)),
        "summary": ((result or {}).get("summary") or "")[:1500],
        "cause": run_cause(runs / f"{rid}.log", result) if state in ("failed", "stalled", "abandoned") else "",
    }


def collect_runs(repo, now):
    out, seen = [], set()
    for runs in repo.run_dirs:
        try:
            entries = os.scandir(runs)
        except OSError:
            continue
        with entries:
            for e in entries:
                rid = e.name[:-4]
                if not e.name.endswith(".log") or rid in seen:
                    continue
                mtime = e.stat().st_mtime
                if now - mtime <= RUN_WINDOW_S and RUN_ID_RE.match(rid):
                    seen.add(rid)
                    out.append(read_run(runs, rid, mtime, now, repo.projects, repo.run_dirs))
    return sorted(out, key=lambda r: r["updated"])


def final_text(message):
    content = message.get("content")
    if isinstance(content, str):
        return content
    texts = [c.get("text", "") for c in content or [] if isinstance(c, dict) and c.get("type") == "text"]
    return texts[-1] if texts else ""


def prompt_text(msg):
    content = msg.get("content")
    if isinstance(content, list):
        if any(isinstance(b, dict) and b.get("type") == "tool_result" for b in content):
            return ""
        content = " ".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text")
    text = " ".join(PASTED_RE.sub(" ", str(content or "")).split())
    cmd = COMMAND_RE.search(text)
    if cmd:
        args = (ARGS_RE.search(text) or [None, ""])[1].strip()
        return "" if cmd.group(1).strip() in CONTROL_COMMANDS and not args else " ".join(x for x in (cmd.group(1), args) if x)
    return "" if text.startswith(("<", "Caveat:", "[Request interrupted")) else text


SERVER_TOOL_TEXT = {"advisor": "Advisor: a stronger model is reviewing the work"}


def tool_action(msg):
    uses = [c for c in msg.get("content") or [] if isinstance(c, dict) and c.get("type") in ("tool_use", "server_tool_use")]
    if not uses:
        return "", ""
    name, inp, uid = uses[-1].get("name", ""), uses[-1].get("input") or {}, uses[-1].get("id", "")
    if name in SERVER_TOOL_TEXT:
        return SERVER_TOOL_TEXT[name], uid
    detail = inp.get("description") or inp.get("skill") or inp.get("file_path") or inp.get("pattern") \
        or inp.get("command") or inp.get("prompt") or inp.get("query") or inp.get("url") or ""
    if name in ("Read", "Edit", "Write") and detail:
        detail = Path(str(detail)).name
    detail = " ".join(str(detail).split())
    return (f"{name}: {detail[:160]}" if detail else name), uid


def result_ids(msg):
    content = msg.get("content")
    return {c["tool_use_id"] for c in content if isinstance(c, dict) and c.get("tool_use_id")} if isinstance(content, list) else set()


def ask_of(d):
    if d.get("isSidechain") or d.get("isMeta"):
        return ""
    if d.get("type") == "user":
        return prompt_text(d.get("message") or {})
    att = d.get("attachment") if d.get("type") == "attachment" else None
    if isinstance(att, dict) and att.get("type") == "queued_command" and (att.get("origin") or {}).get("kind") == "human":
        return " ".join(str(att.get("prompt") or "").split())
    return ""


def latest_ask(path):
    key = str(path)
    offset, ask, at = LAST_ASKS.get(key, (0, "", 0))
    try:
        with path.open("rb") as fh:
            if fh.seek(0, 2) < offset:
                offset, ask, at = 0, "", 0
            fh.seek(offset)
            chunk = fh.read()
    except OSError:
        return ask, at
    end = chunk.rfind(b"\n") + 1
    for line in chunk[:end].splitlines():
        if b'"user"' not in line and b'queued_command' not in line:
            continue
        try:
            d = json.loads(line)
        except ValueError:
            continue
        found = ask_of(d)
        if found:
            ask, at = found, iso_epoch(d.get("timestamp", ""))
    LAST_ASKS[key] = (offset + end, ask, at)
    return ask, at


def snippet(text, size=420):
    text = text.strip()
    if len(text) <= size:
        return text
    cut = text[-size:]
    nl = cut.find("\n\n")
    return ("… " + cut[nl + 2:]) if 0 <= nl < size // 2 else "… " + cut


def result_text(block):
    content = block.get("content")
    if isinstance(content, list):
        content = " ".join(c.get("text", "") for c in content if isinstance(c, dict))
    return str(content or "")


def turn_ended(log):
    for line in reversed(tail_lines(log, 65536)):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if d.get("type") in ("user", "assistant"):
            return d["type"] == "assistant" and (d.get("message") or {}).get("stop_reason") == "end_turn"
    return False


def agent_items(session_dir, ended, now):
    out = []
    for meta_file in (session_dir / "subagents").glob("*.meta.json"):
        log = meta_file.with_name(meta_file.name.replace(".meta.json", ".jsonl"))
        try:
            at = log.stat().st_mtime
        except OSError:
            continue
        aid = log.stem.removeprefix("agent-")
        meta = load_json(meta_file) or {}
        state = ended.get(aid) or ("completed" if turn_ended(log) else "running")
        if state == "running" and now - at > AGENT_STALE_S:
            continue
        if state == "running" or now - at <= ACTIVITY_KEEP_S:
            kind = meta.get("agentType", "").split(":")[-1]
            label = " · ".join(x for x in (kind, meta.get("description", "")) if x)
            out.append({"id": aid, "label": label, "state": state, "at": at, "path": str(log)})
    return sorted(out, key=lambda x: -x["at"])[:ACTIVITY_MAX]


def note_background(d, msg, bg):
    if d["type"] == "assistant":
        for c in msg.get("content") or []:
            inp = c.get("input") if isinstance(c, dict) and c.get("type") == "tool_use" and c.get("name") == "Bash" else None
            if isinstance(inp, dict):
                facts = {"description": " ".join(str(inp.get("description") or "").split())[:160],
                         "command": str(inp.get("command") or "")[:4000], "started": iso_epoch(d.get("timestamp") or "")}
                bg["bash"][c.get("id", "")] = facts
                if inp.get("run_in_background"):
                    bg["labels"][c.get("id", "")] = facts
        return
    result = d.get("toolUseResult")
    task = result.get("backgroundTaskId") if isinstance(result, dict) else None
    if task:
        bg["tasks"][task] = next((bg["labels"][u] for u in result_ids(msg) if u in bg["labels"]), {})


def created_at(path):
    try:
        return path.stat().st_ctime
    except OSError:
        return 0


def shell_items(path, bg, ended, now, skip=(), cwd=""):
    launched = bg["tasks"]
    tasks = Path(os.environ.get("CLAUDE_CODE_TMPDIR") or "/tmp") / f"claude-{os.getuid()}" / path.parent.name / path.stem / "tasks"
    out, logs = [], sorted(tasks.glob("*.output"), key=created_at)
    moved = [x.stem for x in logs if x.stem not in launched and x.stem not in ended and x.stem not in skip]
    launched = {**dict(zip(moved[::-1], [dict(f, moved=True) for f in bg.get("pending", [])[::-1]])), **launched}
    for log in logs:
        tid = log.stem
        try:
            at = log.stat().st_mtime
        except OSError:
            continue
        if tid in skip or not SOURCE_ID_RE.match(tid):
            continue
        state = ended.get(tid) or "running"
        if state == "running" and (now - at > AGENT_STALE_S or tid not in launched):
            continue
        if state == "running" or now - at <= ACTIVITY_KEEP_S:
            out.append({"id": tid, "label": "shell · " + (launched.get(tid, {}).get("description") or tid),
                        "state": state, "at": at, "path": str(log),
                        "shell": shell_facts(log, launched.get(tid, {}), bg["exit"].get(tid), cwd)})
    return sorted(out, key=lambda x: (x["state"] != "running", -x["at"]))[:ACTIVITY_MAX]


def shell_facts(log, launch, code, cwd):
    command = launch.get("command", "")
    tail = "\n".join(tail_lines(log, 8192))
    run = SHELL_RUN_RE.findall(tail) or SHELL_RUN_RE.findall(command)
    brief = SHELL_BRIEF_RE.search(command)
    target = SHELL_CD_RE.search(command)
    return {"description": launch.get("description", ""), "command": command, "started": launch.get("started") or 0,
            "exit": code, "cwd": target.group(1) if target else cwd, "brief": brief.group(1) if brief else "",
            "run": run[-1] if run else "", "moved": bool(launch.get("moved"))}


def shell_output(path):
    return ANSI_RE.sub("", "\n".join(tail_lines(path, OUTPUT_CHARS * 2)))[-OUTPUT_CHARS:] or "(no output yet)"


def codex_transcript_lines(p):
    kind = p.get("type")
    if kind == "message" and p.get("role") in ("user", "assistant"):
        text = codex_text(p)
        if p["role"] == "assistant" and text:
            return [f"\nCodex: {text}"]
        return [f"\n› You: {' '.join(text.split())}"] if text and not text.startswith("<") else []
    if kind in ("function_call", "custom_tool_call"):
        return [f"  ⚙ {codex_action(p)}"]
    if kind in ("function_call_output", "custom_tool_call_output"):
        out = p.get("output")
        text = " ".join(str(out.get("content") if isinstance(out, dict) else out or "").split())
        return [f"    ↳ {text[:300]}{'…' if len(text) > 300 else ''}"] if text else []
    return []


def render_transcript(path):
    out = []
    for line in tail_lines(path, 400000):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if d.get("type") == "response_item":
            out += codex_transcript_lines(d.get("payload") or {})
            continue
        if d.get("type") not in ("user", "assistant"):
            continue
        msg = d.get("message") or {}
        content = msg.get("content")
        blocks = content if isinstance(content, list) else []
        if d["type"] == "user":
            ask = prompt_text(msg)
            if ask:
                out.append(f"\n› You: {ask}")
            for b in blocks:
                if isinstance(b, dict) and b.get("type") == "tool_result":
                    text = " ".join(result_text(b).split())
                    out.append(f"    ↳ {text[:300]}{'…' if len(text) > 300 else ''}")
            continue
        for b in blocks:
            if not isinstance(b, dict):
                continue
            if b.get("type") == "text" and b.get("text", "").strip():
                out.append(f"\nClaude: {b['text'].strip()}")
            elif b.get("type") == "tool_use":
                out.append(f"  ⚙ {tool_action({'content': [b]})}")
    return "\n".join(out)[-OUTPUT_CHARS:]


def subagent_chips(session_dir, now):
    chips, busy = [], False
    sub = session_dir / "subagents"
    if not sub.is_dir():
        return chips, busy
    for meta_file in sub.glob("*.meta.json"):
        log = meta_file.with_name(meta_file.name.replace(".meta.json", ".jsonl"))
        try:
            mtime = log.stat().st_mtime
        except OSError:
            continue
        if now - mtime < SUBAGENT_BUSY_S:
            busy = True
        meta = load_json(meta_file) or {}
        kind = meta.get("agentType", "")
        if now - mtime > SESSION_WINDOW_S or not kind.endswith(("test-runner", "diff-reviewer")):
            continue
        verdict, lens = "", ""
        for line in tail_lines(log, 65536):
            try:
                d = json.loads(line)
            except ValueError:
                continue
            msg = d.get("message") or {}
            if d.get("type") == "assistant":
                first = final_text(msg).strip().splitlines()[:1]
                m = re.match(r"(RESULT|VERDICT):\s*(\w+)", first[0]) if first else None
                verdict = m.group(2) if m else verdict
        try:
            head = log.open(encoding="utf-8", errors="replace").read(4096)
            m = re.search(r"LENS:\s*(\w+)", head)
            lens = m.group(1) if m else ""
        except OSError:
            pass
        if verdict:
            chips.append({"kind": "tests" if kind.endswith("test-runner") else lens or "review",
                          "verdict": verdict, "at": mtime, "label": meta.get("description", "")})
    return chips, busy


def first_prompt(path):
    key = str(path)
    if key not in FIRST_PROMPTS:
        found = ""
        try:
            with path.open(encoding="utf-8", errors="replace") as fh:
                head = fh.read(TAIL_BYTES).splitlines()[:-1]
        except OSError:
            head = []
        for line in head:
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if d.get("type") != "user" or d.get("isMeta") or d.get("isSidechain"):
                continue
            content = (d.get("message") or {}).get("content")
            if isinstance(content, list):
                content = " ".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text")
            text = " ".join(str(content or "").split())
            if text and not text.startswith(("<", "Caveat:", "[Request interrupted")):
                found = text[:60] + ("…" if len(text) > 60 else "")
                break
        FIRST_PROMPTS[key] = found
    return FIRST_PROMPTS[key]


def read_session(path, now, wt_re, names, waits):
    mtime = path.stat().st_mtime
    sid = path.stem
    last, cwd, branch, title, text = None, "", "", "", ""
    action, action_at, action_id, said_at, seen_at, turn_at = "", "", "", "", "", ""
    mentions, briefs, answered = {}, set(), set()
    finished, bg = {}, {"labels": {}, "tasks": {}, "exit": {}, "bash": {}, "pending": []}
    for line in message_tail(path):
        for m in NOTE_RE.finditer(line):
            finished[m.group(1)] = m.group(2)
        for m in SHELL_EXIT_RE.finditer(line):
            bg["exit"][m.group(1)] = int(m.group(2))
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if d.get("type") == "custom-title":
            title = d.get("customTitle") or title
        seen_at = d.get("timestamp") or seen_at
        if d.get("isSidechain") or d.get("type") not in ("user", "assistant"):
            continue
        cwd, branch = d.get("cwd") or cwd, d.get("gitBranch") or branch
        msg = d.get("message") or {}
        answered |= result_ids(msg)
        note_background(d, msg, bg)
        if d["type"] == "assistant":
            said = final_text(msg)
            if said:
                text, said_at = said, d.get("timestamp") or said_at
            done, uid = tool_action(msg)
            if done:
                action, action_at, action_id = done, d.get("timestamp") or action_at, uid
        last = (d["type"], msg.get("stop_reason"), d.get("timestamp"))
        if last[:2] == ("assistant", "end_turn"):
            turn_at = last[2] or turn_at
        if wt_re:
            for m in wt_re.findall(line):
                mentions[m] = mentions.get(m, 0) + 1
        briefs.update(BRIEF_RE.findall(line))
    if not last:
        return None
    chips, busy = subagent_chips(path.with_suffix(""), now)
    ended = last[0] == "assistant" and last[1] == "end_turn"
    updated = iso_epoch(seen_at) or mtime
    idle = now - updated
    tail = URL_RE.sub("", text[-500:])
    asks = "?" in tail or bool(ASK_RE.search(tail.strip().rsplit("\n\n", 1)[-1]))
    ask, ask_at = latest_ask(path)
    declared = waits.get(sid) if isinstance(waits.get(sid), dict) else {}
    need = declared.get("need", "") if iso_epoch(declared.get("at", "")) >= ask_at else ""
    state = "working"
    if ended and not busy:
        if need or asks and idle >= WAIT_MIN_S:
            state = "waiting"
        elif not asks and idle >= STILL_OPEN_S:
            state = "still_open"
        else:
            state = "idle"
    elif not ended and idle > STALL_S and not busy:
        state = "quiet"
    worktree = max(mentions, key=mentions.get) if mentions else ""
    agents = agent_items(path.with_suffix(""), finished, now)
    use = session_usage(path, now)
    for a in agents:
        a.update({k: v for k, v in (use or {}).get("agents", {}).get(a["id"], {}).items() if k != "label"})
    bg["pending"] = [f for u, f in bg["bash"].items() if u not in answered and u not in bg["labels"]]
    return {
        "id": sid, "name": title or names.get(sid) or first_prompt(path) or f"{Path(cwd).name or 'session'} {sid[:8]}",
        "named": bool(title or names.get(sid)),
        "title": title,
        "cwd": cwd, "branch": branch, "worktree": worktree, "state": state, "updated": updated,
        "turn_at": iso_epoch(turn_at),
        "agents": agents + shell_items(path, bg, finished, now, {a["id"] for a in agents}, cwd),
        "idle": idle, "snippet": snippet(text) if state in ("waiting", "still_open", "idle") else "",
        "briefs": sorted(briefs), "chips": chips,
        "ask": snippet(ask, 600), "need": need, "action": action, "action_at": iso_epoch(action_at),
        "action_running": state == "working" and bool(action_id) and action_id not in answered, "said_at": iso_epoch(said_at),
        "said": snippet(text, 600), "said_full": text[-SAID_MAX:], "docs": message_docs(text, cwd),
        "usage": use,
    }


def worktree_re(repo, trees):
    wt = [re.escape(p) for p in trees if Path(p) != repo.root]
    return re.compile("(" + "|".join(sorted(wt, key=len, reverse=True)) + r")(?![\w.-])") if wt else None


def collect_sessions(repo, trees, now, names, waits):
    paths = [repo.root] + [Path(p) for p in trees if Path(p) != repo.root]
    wt_re = worktree_re(repo, trees)
    out = []
    for base in repo.projects:
        for p in paths:
            d = base / encode_project(p)
            if not d.is_dir():
                continue
            for f in d.glob("*.jsonl"):
                try:
                    if now - f.stat().st_mtime > SESSION_WINDOW_S:
                        continue
                except OSError:
                    continue
                s = read_session(f, now, wt_re, names, waits)
                if s:
                    if Path(s["cwd"]) != repo.root and s["cwd"] in trees:
                        s["worktree"] = s["cwd"]
                    out.append(s)
    return out


def repo_top(cwd):
    for d in [Path(cwd), *Path(cwd).parents] if cwd else []:
        if (d / ".git").exists():
            return d
    return None


def message_docs(text, cwd):
    out, seen, top = [], set(), repo_top(cwd)
    bases = list(dict.fromkeys(b for b in (Path(cwd) if cwd else None, top) if b))
    for shown in dict.fromkeys(MD_PATH_RE.findall(text)):
        raw = Path(shown).expanduser()
        dirs = bases + ([Path(d["path"]).parent for d in out] if "/" not in shown else [])
        for cand in [raw] if raw.is_absolute() else [b / raw for b in dict.fromkeys(dirs)]:
            try:
                real = cand.resolve()
                if real.is_file():
                    if real not in seen:
                        seen.add(real)
                        out.append({"name": real.name, "shown": shown, "path": str(real), "size": real.stat().st_size})
                    break
            except OSError:
                continue
        if len(out) >= DOCS_MAX:
            break
    return out


def reply_logged(config, sid, turn_at):
    for line in reversed(tail_lines(config / "fullstack-agents" / "classifier.jsonl", 131072)):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if iso_epoch(d.get("at") or "") < turn_at - 2:
            return False
        if d.get("mode") in ("reply", "phase") and d.get("session") == sid:
            return True
    return False


def run_classifier(path, session):
    hook = {"session_id": session["id"], "transcript_path": str(path), "cwd": session["cwd"]}
    run_mode("reply", hook, path.parents[2])


def run_mode(mode, hook, config):
    try:
        subprocess.run([sys.executable, str(HERE / "fsa-classify"), mode], input=json.dumps(hook), text=True,
                       capture_output=True, timeout=90, env={**os.environ, "CLAUDE_CONFIG_DIR": str(config)})
    except (subprocess.TimeoutExpired, OSError):
        pass


def fresh_sessions(repo, trees, now):
    roots, out, seen = {str(repo.root), *trees}, [], set()
    for base in repo.projects:
        for f in (base.parent / "sessions").glob("*.json"):
            info = load_json(f) or {}
            sid, cwd = info.get("sessionId"), info.get("cwd") or ""
            if not sid or sid in seen or info.get("kind") != "interactive" or cwd not in roots \
                    or not Path(f"/proc/{f.stem}").exists() or session_transcript(repo.projects, sid):
                continue
            seen.add(sid)
            started = (info.get("startedAt") or 0) / 1000 or now
            name = info.get("name") or f"session {sid[:8]}"
            out.append({
                "id": sid, "name": name, "named": True, "title": name, "fresh": True,
                "cwd": cwd, "branch": "", "worktree": cwd if cwd != str(repo.root) else "", "state": "waiting",
                "updated": started, "turn_at": started, "agents": [], "idle": now - started,
                "snippet": FRESH_NOTE, "briefs": [], "chips": [], "ask": FRESH_NOTE, "need": FRESH_NOTE,
                "action": "", "action_at": 0, "action_running": False, "said_at": 0, "said": "", "said_full": "", "docs": [],
            })
    return out


def codex_rollouts(now):
    out = []
    for back in range(SESSION_WINDOW_S // 86400 + 2):
        day = datetime.fromtimestamp(now - back * 86400)
        for f in (CODEX_HOME / "sessions" / f"{day:%Y}" / f"{day:%m}" / f"{day:%d}").glob("rollout-*.jsonl"):
            try:
                if now - f.stat().st_mtime <= SESSION_WINDOW_S:
                    out.append(f)
            except OSError:
                continue
    return out


def codex_meta(path):
    key = str(path)
    if key not in CODEX_META:
        meta = {}
        try:
            with path.open(encoding="utf-8", errors="replace") as fh:
                first = json.loads(fh.readline() or "{}")
            if first.get("type") == "session_meta":
                meta = first.get("payload") or {}
        except (OSError, ValueError):
            pass
        CODEX_META[key] = meta
    return CODEX_META[key]


def codex_thread_names():
    names = {}
    try:
        with (CODEX_HOME / "session_index.jsonl").open(encoding="utf-8", errors="replace") as fh:
            for line in fh:
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if d.get("id") and d.get("thread_name"):
                    names[d["id"]] = d["thread_name"]
    except OSError:
        pass
    return names


def codex_live():
    """Rollout path -> (herdr pane, holder pid, rollouts that pid holds) for every open Codex transcript."""
    out = {}
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            targets = [os.readlink(fd) for fd in (proc / "fd").iterdir()]
        except OSError:
            continue
        rollouts = [t for t in targets if "/sessions/" in t and Path(t).name.startswith("rollout-") and t.endswith(".jsonl")]
        if not rollouts:
            continue
        pane = proc_pane(proc.name)
        for t in rollouts:
            out[t] = (pane or (out.get(t) or ("",))[0], int(proc.name), len(rollouts))
    return out


def codex_thread_model(sid):
    """Read the exact thread's current model, without guessing from configuration."""
    dbs = sorted(CODEX_HOME.glob("state_*.sqlite"), key=lambda p: int(re.sub(r"\D", "", p.stem) or 0))
    if not dbs:
        return ""
    try:
        con = sqlite3.connect(f"file:{dbs[-1]}?mode=ro", uri=True, timeout=1)
        try:
            row = con.execute("SELECT model FROM threads WHERE id = ?", (sid,)).fetchone()
        finally:
            con.close()
    except sqlite3.Error:
        return ""
    model = row[0] if row else None
    return model if isinstance(model, str) and model.strip() and not any(ord(c) < 32 for c in model) else ""


def codex_children():
    """Parent thread id -> [(child id, edge status, rollout, label)] from Codex's own state database."""
    dbs = sorted(CODEX_HOME.glob("state_*.sqlite"), key=lambda p: int(re.sub(r"\D", "", p.stem) or 0))
    if not dbs:
        return {}
    out = {}
    try:
        con = sqlite3.connect(f"file:{dbs[-1]}?mode=ro", uri=True, timeout=1)
        try:
            rows = con.execute(
                "SELECT e.parent_thread_id, e.child_thread_id, e.status, t.rollout_path, "
                "COALESCE(NULLIF(t.agent_nickname, ''), NULLIF(t.agent_role, ''), NULLIF(t.name, ''), t.title) "
                "FROM thread_spawn_edges e JOIN threads t ON t.id = e.child_thread_id").fetchall()
        finally:
            con.close()
    except sqlite3.Error:
        return {}
    for parent, child, status, rollout, label in rows:
        out.setdefault(parent, []).append((child, status or "", rollout or "", label or ""))
    return out


CODEX_TURN_SCAN = {}
# Codex emits this fixed envelope order. Matching its structural prefix avoids
# allocating a potentially huge last_agent_message on native completion events.
CODEX_TURN_HEADER = re.compile(
    rb'^\s*\{\s*(?:"timestamp"\s*:\s*"(?:[^"\\]|\\.)*"\s*,\s*)?'
    rb'"type"\s*:\s*"event_msg"\s*,\s*"payload"\s*:\s*\{\s*'
    rb'"type"\s*:\s*"(task_started|task_complete)"(?=\s*[,}])'
)


def codex_turn_open(path):
    """Read native turn boundaries incrementally, not a short tail of a long turn.

    Only complete native event records count. Tool text, activity leases and
    process guesses cannot open a turn; long output lines are skipped in bounded
    chunks. A partial final record is retried after its newline arrives.
    """
    key, line_limit = str(path), 65536
    try:
        with open(path, "rb") as stream:
            before = os.fstat(stream.fileno())
            identity = (before.st_dev, before.st_ino)
            cached = CODEX_TURN_SCAN.get(key)
            prefix = stream.read(min(before.st_size, 4096))
            offset, opened = 0, False
            if (cached and cached[0] == identity and before.st_size >= cached[1]
                    and prefix[:len(cached[5])] == cached[5]
                    and (before.st_size != cached[1] or before.st_mtime_ns == cached[2])):
                offset, opened = cached[3:5]
            stream.seek(offset)
            while True:
                start = stream.tell()
                raw = stream.readline(line_limit + 1)
                if not raw:
                    break
                oversized = len(raw) > line_limit
                header = CODEX_TURN_HEADER.match(raw) if oversized else None
                while oversized and raw and not raw.endswith(b"\n"):
                    raw = stream.readline(line_limit + 1)
                if not raw.endswith(b"\n"):
                    stream.seek(start)
                    break
                if oversized:
                    if header:
                        opened = header[1] == b"task_started"
                    continue
                if b'"task_started"' not in raw and b'"task_complete"' not in raw:
                    continue
                try:
                    record = json.loads(raw)
                    payload = record.get("payload") or {}
                    if record.get("type") == "event_msg" and payload.get("type") in ("task_started", "task_complete"):
                        opened = payload["type"] == "task_started"
                except (ValueError, AttributeError, TypeError):
                    continue
            after = os.fstat(stream.fileno())
            CODEX_TURN_SCAN[key] = (identity, after.st_size, after.st_mtime_ns, stream.tell(), opened, prefix)
            if len(CODEX_TURN_SCAN) > 1024:
                CODEX_TURN_SCAN.pop(next(iter(CODEX_TURN_SCAN)))
            return opened
    except OSError:
        return False


def proc_parent(pid):
    try:
        return int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        return None


def proc_children():
    kids = {}
    for proc in Path("/proc").iterdir():
        if proc.name.isdigit():
            ppid = proc_parent(proc.name)
            if ppid is not None:
                kids.setdefault(ppid, []).append(int(proc.name))
    return kids


def nested_in(pid, others, parent=proc_parent):
    """True when an ancestor process of `pid` is one of `others`."""
    seen, pid = set(), parent(pid)
    while pid and pid > 1 and pid not in seen:
        if pid in others:
            return True
        seen.add(pid)
        pid = parent(pid)
    return False


def proc_agents(pid, kids, now):
    """Agent CLIs (claude -p, codex exec, ...) running anywhere under process `pid`."""
    out, todo = [], list(kids.get(pid, []))
    while todo:
        child = todo.pop()
        todo += kids.get(child, [])
        try:
            argv = Path(f"/proc/{child}/cmdline").read_bytes().decode("utf-8", "replace").split("\0")
        except OSError:
            continue
        name = Path(argv[0]).name
        if name not in HERDR_AGENT_KINDS or name == "codex" and argv[1:2] == ["app-server"]:
            continue
        label = " ".join(a for a in argv[:6] if a and len(a) <= 40 and "\n" not in a)
        out.append({"id": f"pid-{child}", "label": label, "state": "running", "at": now, "path": ""})
    return out


def codex_run_records(sid, now):
    """Read only exact-session records and confined, regular artifact files."""
    safe = lambda value: isinstance(value, str) and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,199}", value)
    sane = lambda value: type(value) in (int, float) and math.isfinite(value) and 0 < value <= now + 60
    if not safe(sid):
        return []
    directory = CODEX_HOME / "fsa-flow" / "runs" / sid
    out = []
    if any(p.is_symlink() for p in (directory, directory.parent, directory.parent.parent)):
        return out
    for path in sorted(directory.glob("*.json"), reverse=True)[:500]:
        try:
            if path.is_symlink() or path.stat().st_size > 65536:
                continue
            r = json.loads(path.read_text())
            if (not isinstance(r, dict) or r.get("session_id") != sid or not safe(r.get("run_id"))
                    or path.stem != r["run_id"] or r.get("role") not in ("implementer", "investigator", "auditor")
                    or r.get("engine") not in ("codex", "claude")
                    or r.get("state") not in ("running", "completed", "failed", "incomplete", "out_of_scope")
                    or not sane(r.get("started")) or not sane(r.get("updated")) or r["started"] > r["updated"]
                    or any(not isinstance(r.get(k), str) for k in ("root", "artifact", "summary"))
                    or any(r.get(k) is not None and not isinstance(r[k], str) for k in ("model", "brief", "events_path"))
                    or r.get("child_session_id") is not None and not safe(r["child_session_id"])
                    or r.get("verdict") not in (None, "PASS", "CHANGES")
                    or not isinstance(r.get("tests", []), list)
                    or any(not isinstance(check, str) for check in r.get("tests", []))
                    or r.get("verdict") is not None and (r["role"] != "auditor" or r["state"] != "completed")):
                continue
            artifact = Path(r["artifact"])
            if not artifact.is_absolute() or artifact.is_symlink() or not artifact.is_dir():
                continue
            events = Path(r["events_path"]) if r.get("events_path") else None
            if events and (events.is_symlink() or events.resolve().parent != artifact.resolve()):
                continue
            if events and not r.get("child_session_id"):
                with events.open() as stream:
                    for _, line in zip(range(100), stream):
                        try:
                            event = json.loads(line)
                        except ValueError:
                            continue
                        if isinstance(event, dict) and event.get("type") == "thread.started" and safe(event.get("thread_id")):
                            r["child_session_id"] = event["thread_id"]
                            break
            out.append(r)
        except (OSError, ValueError, TypeError, AttributeError):
            continue
    return sorted(out, key=lambda r: r["started"])


CODEX_TASK_NAMES = {}


def codex_task_name(rollout):
    """Task name a Codex subagent was given; the task text itself is stored encrypted."""
    if rollout not in CODEX_TASK_NAMES:
        name = ""
        try:
            with open(rollout, "rb") as f:
                for raw in f:
                    if b'"agent_message"' not in raw:
                        continue
                    try:
                        recipient = (json.loads(raw).get("payload") or {}).get("recipient") or ""
                    except (ValueError, AttributeError):
                        continue
                    name = " ".join(str(recipient).rsplit("/", 1)[-1].replace("_", " ").split())[:120]
                    break
        except OSError:
            pass
        CODEX_TASK_NAMES[rollout] = name
    return CODEX_TASK_NAMES[rollout]


def codex_agent_items(sid, children, holder, kids, now, registrations=()):
    out = [{"id": r.get("child_session_id") or r["run_id"],
            "label": " · ".join(x for x in (r["engine"], r["role"], r.get("model")) if x),
            "state": r["state"], "at": r["updated"], "path": r.get("events_path") or "",
            "parent_id": sid} for r in registrations]
    registered = {item["id"] for item in out}
    seen = {sid}
    todo = [(sid, child) for child in children.get(sid, [])]
    while todo:
        parent, (child, status, rollout, label) = todo.pop(0)
        if child in seen:
            continue
        seen.add(child)
        todo.extend((child, item) for item in children.get(child, []))
        if child in registered:
            continue
        try:
            at = Path(rollout).stat().st_mtime
        except OSError:
            continue
        running = status == "open" and codex_turn_open(Path(rollout)) and now - at <= AGENT_STALE_S
        if running or now - at <= ACTIVITY_KEEP_S:
            out.append({"id": child, "label": " · ".join(x for x in ("codex", label) if x),
                        "state": "running" if running else "completed", "at": at, "path": rollout,
                        "parent_id": parent, "task": codex_task_name(rollout)})
    # Registered CLIs already have durable ownership; shared app-server inference is ambiguous.
    if holder and holder[2] == 1 and not registrations:
        out += proc_agents(holder[1], kids, now)
    return sorted(out, key=lambda x: -x["at"])


def codex_text(payload):
    return "\n".join(c.get("text", "") for c in payload.get("content") or []
                     if isinstance(c, dict) and c.get("type") in ("input_text", "output_text")).strip()


def codex_action(payload):
    name, raw = payload.get("name") or "", payload.get("arguments") or payload.get("input") or ""
    try:
        args = json.loads(raw) if isinstance(raw, str) and raw.startswith("{") else {}
    except ValueError:
        args = {}
    detail = args.get("cmd") or args.get("command") or args.get("path") if isinstance(args, dict) else ""
    detail = " ".join(str(detail or (raw if not args else "")).split())
    return f"{name}: {detail[:160]}" if detail else name


WORKFLOW_PHASES = {"investigate", "plan", "implement", "validate", "audit", "complete"}


def codex_workflow(sid, cwd, now):
    """Accept only a coherent journal belonging to this exact session and cwd."""
    if not isinstance(sid, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,199}", sid):
        return {}
    try:
        record = json.loads((CODEX_HOME / "fsa-flow" / f"{sid}.json").read_text(encoding="utf-8"))
        sane = lambda value: type(value) in (int, float) and math.isfinite(value) and 0 < value <= now + 60
        if (not isinstance(record, dict) or record.get("session_id") != sid
                or record.get("engine") != "codex" or record.get("cwd") != str(Path(cwd).resolve())
                or record.get("phase") not in WORKFLOW_PHASES or not sane(record.get("updated"))):
            return {}
        history = record.get("history")
        if (not isinstance(history, list) or not 1 <= len(history) <= 100
                or any(not isinstance(e, dict) or e.get("phase") not in WORKFLOW_PHASES
                       or not sane(e.get("timestamp")) for e in history)
                or any(a["timestamp"] > b["timestamp"] for a, b in zip(history, history[1:]))
                or history[-1] != {"phase": record["phase"], "timestamp": record["updated"]}):
            return {}
        checks, summary, auditor = record.get("checks", []), record.get("summary", ""), record.get("auditor", "")
        if (not isinstance(checks, list) or any(not isinstance(c, str) for c in checks)
                or not isinstance(summary, str) or not isinstance(auditor, str)):
            return {}
        return {"workflow_checks": checks, "workflow_summary": summary, "workflow_auditor": auditor,
                "workflow_phase": record["phase"], "workflow_at": record["updated"],
                "workflow_history": history}
    except (OSError, ValueError, TypeError):
        return {}


QUESTION_SCAN = {}


def codex_pending_question(path):
    """(title, asynchronous) of the newest request_user_input call that no later user message answered."""
    key = str(path)
    offset, pending = QUESTION_SCAN.get(key, (0, ("", False)))
    try:
        with open(path, "rb") as f:
            if f.seek(0, os.SEEK_END) < offset:
                offset, pending = 0, ("", False)
            f.seek(offset)
            data = f.read()
    except OSError:
        return "", False
    complete = data.rfind(b"\n") + 1
    for raw in data[:complete].splitlines():
        if b"request_user_input" not in raw and b'"user"' not in raw:
            continue
        try:
            p = json.loads(raw).get("payload") or {}
        except (ValueError, AttributeError):
            continue
        if p.get("type") == "function_call" and str(p.get("name", "")).startswith("request_user_input"):
            pending = codex_question(p), p.get("name") == "request_user_input_async"
        elif p.get("type") == "message" and p.get("role") == "user" and (codex_text(p) or "<").strip()[:1] != "<":
            pending = "", False
    QUESTION_SCAN[key] = (offset + complete, pending)
    return pending


def codex_question(payload):
    try:
        questions = json.loads(payload.get("arguments") or "{}").get("questions") or []
    except (ValueError, AttributeError):
        return "Codex asked a question in its terminal"
    first = questions[0] if questions and isinstance(questions[0], dict) else {}
    return " ".join(str(first.get("title") or first.get("question") or "Codex asked a question in its terminal").split())[:300]


def read_codex_session(repo, path, meta, now, names, waits, pane, pane_status, agents=(), wt_re=None):
    sid = meta.get("id") or meta.get("session_id") or path.stem[-36:]
    cwd, branch = meta.get("cwd") or "", (meta.get("git") or {}).get("branch") or ""
    said = ask = action = action_id = model = ""
    for line in reversed(tail_lines(path, 1048576)):
        if '"turn_context"' not in line:
            continue
        try:
            record = json.loads(line)
            if record.get("type") == "turn_context":
                candidate = record.get("payload", {}).get("model")
                if isinstance(candidate, str):
                    model = candidate
                    break
        except (ValueError, AttributeError):
            continue
    said_at = ask_at = action_at = turn_at = seen_at = ""
    turn_open, answered, briefs, mentions = None, set(), set(), {}
    for line in tail_lines(path):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        ts, p = d.get("timestamp") or "", d.get("payload") or {}
        seen_at = ts or seen_at
        kind = (d.get("type"), p.get("type"))
        if d.get("type") == "turn_context":
            cwd = p.get("cwd") or cwd
            if isinstance(p.get("model"), str):
                model = p["model"]
        elif kind == ("event_msg", "task_started"):
            turn_open = True
        elif kind == ("event_msg", "task_complete"):
            turn_open, turn_at = False, ts
        elif kind == ("response_item", "message"):
            text = codex_text(p)
            if p.get("role") == "assistant" and text:
                said, said_at = text, ts
            elif p.get("role") == "user" and text and not text.startswith("<"):
                ask, ask_at = text, ts
        elif kind in (("response_item", "function_call"), ("response_item", "custom_tool_call")):
            action, action_at, action_id = codex_action(p), ts, p.get("call_id") or ""
        elif kind in (("response_item", "function_call_output"), ("response_item", "custom_tool_call_output")):
            answered.add(p.get("call_id"))
        briefs.update(BRIEF_RE.findall(line))
        if wt_re:
            for m in wt_re.findall(line):
                mentions[m] = mentions.get(m, 0) + 1
    if not seen_at:
        return None
    if not model:
        model = codex_thread_model(sid)
    updated = iso_epoch(seen_at) or path.stat().st_mtime
    idle = now - updated
    if turn_open is None:
        turn_open = pane is not None and idle < STALL_S
    tail = URL_RE.sub("", said[-500:])
    asks = "?" in tail or bool(ASK_RE.search(tail.strip().rsplit("\n\n", 1)[-1]))
    declared = waits.get(sid) if isinstance(waits.get(sid), dict) else {}
    need = declared.get("need", "") if iso_epoch(declared.get("at", "")) >= iso_epoch(ask_at) else ""
    question, asynchronous = codex_pending_question(path)
    if pane_status == "blocked" and asynchronous and turn_open and idle < STALL_S:
        state = "working"
    elif pane_status == "blocked":
        state, need = "waiting", need or question or "Codex is waiting for an answer or an approval in its terminal"
    elif turn_open:
        state = "quiet" if idle > STALL_S else "working"
    elif need or asks and idle >= WAIT_MIN_S:
        state = "waiting"
    elif not asks and idle >= STILL_OPEN_S:
        state = "still_open"
    else:
        state = "idle"
    title = names.get(sid) or ""
    return {
        "id": sid, "engine": "codex", "model": model, "pane": pane or "",
        **codex_workflow(sid, cwd, now),
        "name": title or f"codex {Path(cwd).name or 'session'} {sid[:8]}", "named": bool(title), "title": title,
        "cwd": cwd, "branch": branch, "state": state, "question": question if state == "working" else "",
        "worktree": max(mentions, key=mentions.get) if mentions else cwd if cwd != str(repo.root) else "",
        "updated": updated, "turn_at": iso_epoch(turn_at), "agents": list(agents), "idle": idle, "transcript": str(path),
        "snippet": snippet(said) if state in ("waiting", "still_open", "idle") else "",
        "briefs": sorted(briefs), "chips": [], "ask": snippet(ask, 600), "need": need,
        "action": action, "action_at": iso_epoch(action_at),
        "action_running": state == "working" and bool(action_id) and action_id not in answered,
        "said_at": iso_epoch(said_at), "said": snippet(said, 600), "said_full": said[-SAID_MAX:],
        "docs": message_docs(said, cwd), "usage": transcript_usage(path, "codex", now),
    }


def collect_codex_sessions(repo, trees, now, waits):
    roots = {str(repo.root), *trees}
    found = [(f, m) for f in codex_rollouts(now) for m in [codex_meta(f)] if m.get("cwd") in roots]
    if not found:
        return []
    live, children = codex_live(), codex_children()
    registrations = {m.get("id"): codex_run_records(m.get("id"), now) for _, m in found}
    spawned = {r["child_session_id"] for runs in registrations.values() for r in runs if r.get("child_session_id")}
    parents = {}
    for parent, edges in children.items():
        for child, *_ in edges:
            parents.setdefault(child, parent)
    def topmost(sid):
        chain = []
        while sid in parents and sid not in chain:
            chain.append(sid)
            sid = parents[sid]
        return min(chain[chain.index(sid):]) if sid in chain else sid
    spawned.update(sid for sid in parents if topmost(sid) != sid)
    for child in list(registrations):
        parent = topmost(child)
        if parent != child and parent in registrations:
            registrations[parent].extend(registrations[child])
    panes = {str(f): live[str(f)][0] for f, _ in found if str(f) in live}
    status = {}
    if any(panes.values()):
        status = {x["pane_id"]: x["status"] for x in read_herdr_snapshot()["panes"]}
    names, kids = codex_thread_names(), proc_children() if live else {}
    out, wt_re = [], worktree_re(repo, trees)
    for f, meta in found:
        if meta.get("id") in spawned:
            continue
        pane = panes.get(str(f))
        agents = codex_agent_items(meta.get("id"), children, live.get(str(f)), kids, now, registrations.get(meta.get("id"), ()))
        s = read_codex_session(repo, f, meta, now, names, waits, pane, status.get(pane or ""), agents, wt_re)
        if s:
            s["workflow_runs"] = registrations.get(meta.get("id"), [])
            out.append(s)
    return out


def proc_pane(pid):
    try:
        env = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
    except OSError:
        return ""
    return next((e[len(b"HERDR_PANE_ID="):].decode() for e in env if e.startswith(b"HERDR_PANE_ID=")), "")


def herdr_agents(snapshot):
    """Session id -> (cwd, pane) for every herdr pane running a Claude or Codex agent with a transcript."""
    live_panes = {p["pane_id"] for p in snapshot["panes"] if p.get("agent")}
    out, claude = {}, {}
    authoritative = set()
    for pane in snapshot["panes"]:
        identity = pane.get("agent_session")
        if (pane.get("agent") != "codex" and pane.get("agent") and isinstance(identity, dict) and identity.get("kind") == "id"
                and identity.get("agent") == pane["agent"] and isinstance(identity.get("value"), str)
                and identity["value"]):
            out[identity["value"]] = (pane.get("cwd") or "", pane["pane_id"])
            authoritative.add(pane["pane_id"])
    for base in dict.fromkeys(Path(b).expanduser() for b in CLAUDE_BASES if b):
        for f in (base / "sessions").glob("*.json"):
            info = load_json(f) or {}
            pane = proc_pane(f.stem) if info.get("sessionId") and info.get("kind") == "interactive" else ""
            if pane in live_panes and pane not in authoritative and f.stem.isdigit():
                claude[int(f.stem)] = (info["sessionId"], info.get("cwd") or "", pane)
    # A Claude started inside another agent's process tree (a dispatched implementer) belongs to that agent's card.
    for pid, (sid, cwd, pane) in claude.items():
        if not nested_in(pid, claude):
            out[sid] = (cwd, pane)
    spawned = {c for kids in codex_children().values() for c, *_ in kids}
    codex_holders = codex_live()
    for rollout in codex_holders:
        meta = codex_meta(Path(rollout))
        spawned.update(r["child_session_id"] for r in codex_run_records(meta.get("id"), time.time())
                       if r.get("child_session_id"))
    # Shared app-server environments may report another client's pane. Match
    # live transcript identities to exact terminal title segments first.
    names = codex_thread_names()
    candidates = {codex_meta(Path(path)).get("id"): codex_meta(Path(path))
                  for path in codex_holders}
    candidates = {sid: meta for sid, meta in candidates.items() if sid and sid not in spawned}
    codex_panes = [p for p in snapshot["panes"] if p.get("agent") == "codex"]
    assigned = set()
    for pane in codex_panes:
        segments = [part.strip() for part in pane.get("title", "").split(" | ")]
        matches = [sid for sid, meta in candidates.items()
                   if sid not in out and meta.get("cwd") == pane.get("cwd")
                   and names.get(sid) and names[sid] in segments]
        if len(matches) == 1:
            out[matches[0]] = (pane.get("cwd") or "", pane["pane_id"])
            assigned.add(pane["pane_id"])
    for pane in codex_panes:
        if pane["pane_id"] in assigned:
            continue
        # A sole transcript holder has an unambiguous native pane identity.
        matches = [codex_meta(Path(path)).get("id") for path, (native_pane, _, count) in codex_holders.items()
                   if count == 1 and native_pane == pane["pane_id"]
                   and codex_meta(Path(path)).get("id") in candidates]
        identity = pane.get("agent_session")
        if not matches and len(codex_panes) == 1 and isinstance(identity, dict):
            sid = identity.get("value")
            if (identity.get("agent") == "codex" and identity.get("kind") == "id"
                    and isinstance(sid, str) and SOURCE_ID_RE.fullmatch(sid) and sid not in spawned):
                matches = [sid]
        if len(set(matches)) == 1 and matches[0] not in out:
            out[matches[0]] = (pane.get("cwd") or "", pane["pane_id"])
    return out


HERDR_STATES = {"working": "working", "blocked": "waiting"}
PANE_SINCE = {}


def pane_since(pane, now):
    """When the pane entered its current herdr status; stable across polls."""
    status = pane.get("status")
    seen = PANE_SINCE.get(pane["pane_id"])
    if not seen or seen[0] != status:
        seen = PANE_SINCE[pane["pane_id"]] = (status, now)
    return seen[1]


def pane_session(pane, root, now):
    """A card session for an agent pane herdr reports but whose harness keeps no transcript we read."""
    cwd, agent = pane.get("cwd") or "", pane.get("agent") or "agent"
    state = HERDR_STATES.get(pane.get("status"), "idle")
    top = str(repo_top(cwd) or root)
    return {
        "id": f"herdr-{pane['pane_id']}", "engine": agent, "pane": pane["pane_id"],
        "name": pane.get("title") or f"{agent} {Path(cwd).name}", "named": bool(pane.get("title")), "title": "",
        "cwd": cwd, "branch": "", "worktree": top if top != root else "", "state": state, "updated": pane_since(pane, now),
        "turn_at": 0, "agents": [], "idle": 0, "snippet": "", "briefs": [], "chips": [], "ask": "",
        "need": f"{agent} is waiting in herdr pane {pane['pane_id']}" if state == "waiting" else "",
        "action": "", "action_at": 0, "action_running": False, "said_at": 0, "said": "", "said_full": "", "docs": [],
    }


def merge_states(home, parts, now):
    board = load_json(home.board) or {}
    st = {"generated": now, "ui": ui_stamp(), "repo": str(home.root), "main": home.main,
          "cards": [], "waiting": [], "still_open": [], "_sources": {}, "_docs": {}, "_scopes": {},
          "session_panes": {}, "abandoned": [],
          "locks": board.get("locks") or {}, "events": (board.get("events") or [])[-12:],
          "totals": totals([], [], [], now), "history": []}
    for p in parts:
        for k, v in p["totals"].items():
            st["totals"][k] = v if st["totals"][k] is None else st["totals"][k] + (v or 0)
        st["history"] += p["history"]
        for k in ("cards", "waiting", "still_open", "abandoned"):
            st[k] += p[k]
        for k in ("_sources", "_docs", "_scopes", "session_panes"):
            st[k].update(p[k])
    st["cards"].sort(key=lambda c: -c["updated"])
    st["history"].sort(key=lambda h: -h["updated"])
    return st


def judge_codex(s, now):
    """Compatibility entry point: Codex reports phases explicitly, without a classifier."""
    return None


def judge_turns(repo, sessions, now):
    for s in sessions:
        if s.get("engine") == "codex":
            continue
        turn = s["turn_at"]
        if s["state"] not in ("idle", "still_open", "waiting") or s["need"] or not turn or JUDGED.get(s["id"]) == turn \
                or not WAIT_MIN_S <= now - turn <= JUDGE_WINDOW_S:
            continue
        JUDGED[s["id"]] = turn
        path = session_transcript(repo.projects, s["id"])
        if path and not reply_logged(path.parents[2], s["id"], turn):
            threading.Thread(target=run_classifier, args=(path, s), daemon=True).start()


def iso_epoch(ts):
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
    except (AttributeError, ValueError):
        return 0


def session_state_need(state):
    """§14.6 item 1: a bound v2 ledger states its own waiting text, not a reply-text guess."""
    if not state:
        return ""
    if state["state"] == "waiting_user" and state["questions"]:
        return "; ".join(f"{q['id']}: {q['text']} — blocks {', '.join(q['rows'])}: {q['why']}"
                          for q in state["questions"])
    if state["state"] == "waiting_external":
        capacity = [e for e in state["external"] if e.get("class") == "capacity"]
        if capacity:
            return "; ".join(f"waiting for {e['engine']} capacity until {e['until']}" for e in capacity)
    return ""


def apply_session_state_need(session):
    """A ledger's waiting text only overrides state once the session's turn has ended."""
    need = session_state_need(session["task_tracking"].get("session_state"))
    if need and session["state"] in ("idle", "waiting", "still_open"):
        session["state"], session["need"] = "waiting", need


def _ledger_open(sessions):
    for s in sessions:
        t = s.get("task_tracking") or {}
        if t.get("error") or not t.get("file"):
            continue
        state = t.get("session_state")
        if state is not None:
            if state["state"] != "done":
                return True
        elif any(t.get("counts", {}).get(status, 0) for status in task_rules.OPEN):
            return True
    return False


def phase_of(card, runs, sessions):
    if sessions and not runs and all(s.get("fresh") for s in sessions):
        return "review"
    tree = card.get("tree")
    impl = [r for r in runs if r["mode"] == "implement"]
    latest = impl[-1] if impl else None
    if latest:
        card["round"] = fix_depth([r["unit"] for r in sorted(impl, key=lambda r: r["started"] or r["updated"])])
    workflow = max((s for s in sessions if s.get("engine") == "codex"
                    and s.get("workflow_phase") in WORKFLOW_PHASES),
                   key=lambda s: s.get("workflow_at", 0), default=None)
    if workflow:
        return "audit" if workflow["workflow_phase"] == "validate" else workflow["workflow_phase"]
    if latest and latest["state"] in ("running", "stalled"):
        return "rework" if card.get("round", 1) > 1 else "implement"
    declared = card.get("declared")
    since = max(latest["updated"] if latest else 0, declared["at"] if declared else 0)
    edited = (tree or {}).get("phase_edited", (tree or {}).get("edited", 0))
    if tree and edited > max(since, time.time() - EDIT_FRESH_S) and any(s["state"] == "working" for s in sessions):
        return "implement"
    if declared and (not latest or declared["at"] >= latest["updated"]):
        # A finished task stays Done until the session starts working on a new turn.
        if declared["phase"] == "complete" and any(s["state"] == "working" and s.get("turn_at", 0) > declared["at"] for s in sessions):
            return "investigate"
        if declared["phase"] == "complete" and _ledger_open(sessions):
            note = declared.get("note")
            card["declared"] = {**declared, "note": f"{note}; ledger has open work" if note else "ledger has open work"}
            return "review"
        return declared["phase"]
    if latest:
        ended = latest["state"] == "done" and any(
            x["id"] == latest["session"] and x["state"] in ("idle", "waiting", "still_open")
            and x["turn_at"] > latest["updated"] for x in sessions)
        return "review" if ended else "audit"
    briefs_run = {r["unit"] for r in runs}
    if any(set(s["briefs"]) - briefs_run for s in sessions):
        return "plan"
    return "idle" if sessions and all(s["state"] == "still_open" for s in sessions) else "investigate"


def needs_you(card, runs):
    impl = [r for r in runs if r["mode"] == "implement"]
    if not impl:
        return []
    flags = list(impl[-1]["flags"])
    if flags and card.get("round", 1) >= 3:
        flags.append("retries_exhausted")
    return flags


def ui_stamp():
    return int(max((HERE / "lib" / f).stat().st_mtime for f in ("dashboard.html", "fleet.js", "fleet.css", "orchestrators.js")))


def build_state(repo, gc, only=None, extra=(), pane_bindings=None):
    now = time.time()
    trees = gc.worktrees(now)
    board = load_json(repo.board) or {}
    names = {e.get("session"): e.get("name") for e in board.get("events", []) if e.get("session")}
    names.update({k: v.get("name") for k, v in (board.get("claims") or {}).items()})
    runs = collect_runs(repo, now)
    sessions = collect_sessions(repo, trees, now, names, board.get("waits") or {})
    sessions += fresh_sessions(repo, trees, now)
    sessions += collect_codex_sessions(repo, trees, now, board.get("waits") or {})
    sessions += extra
    every = list(sessions)
    if only is not None:
        sessions = [s for s in sessions if s["id"] in only]
    if pane_bindings:
        by_session = {s["id"]: s for s in sessions}
        for sid, pane in pane_bindings.items():
            if sid not in by_session:
                s = pane_session(pane, str(repo.root), now)
                s["id"] = sid
                by_session[sid] = s
            s = by_session[sid]
            s["pane"] = pane["pane_id"]
            if s.get("engine", "claude") != "codex":
                continue
            if pane.get("status") == "working":
                s["state"], s["need"] = "working", ""
            elif pane.get("status") == "blocked" and not s.get("question"):
                s["state"] = "waiting"
            elif pane.get("status") in ("idle", "done"):
                s["state"] = "idle"
                if s.get("engine") == "codex":
                    s["need"] = ""
        sessions = list(by_session.values())
    for session in sessions:
        session["task_tracking"] = load_tasks(session["id"], session.get("cwd"))
        apply_session_state_need(session)
    judge_turns(repo, sessions, now)
    favourites = load_json(repo.favourites) or {}
    main_root = str(repo.root)

    groups, old = {}, []
    for r in runs:
        live = r["state"] in ("running", "stalled")
        gone = r["root"] and r["root"] != main_root and r["root"] not in trees
        loose = r["root"] in (None, main_root)
        if loose:
            r["flags"] = [f for f in r["flags"] if f != "out_of_scope"]
        if r["state"] == "abandoned" or gone and not live or loose and not live and now - r["updated"] > LOOSE_RUN_S:
            if r["state"] in ("abandoned", "failed"):
                old.append(r)
            continue
        key = r["root"] if r["root"] and r["root"] != main_root else f"run:{r['id']}"
        groups.setdefault(key, {"runs": [], "sessions": []})["runs"].append(r)
    declared = {}
    for sid, v in (board.get("phases") or {}).items():
        at = iso_epoch(v.get("at", ""))
        if at and v.get("phase") in PHASES:
            declared[sid] = {"phase": v["phase"], "at": at, "note": v.get("note", ""), "worktree": v.get("worktree", "")}
    by_id = {s["id"]: s for s in sessions}
    for g in groups.values():
        for sid in dict.fromkeys(r["session"] for r in g["runs"]):
            if sid in by_id:
                g["sessions"].append(by_id[sid])
    dispatched = {s["id"] for g in groups.values() for s in g["sessions"]}
    for s in sessions:
        if s["id"] in dispatched:
            continue
        own = (declared.get(s["id"]) or {}).get("worktree")
        key = s["worktree"] if s["worktree"] and s["worktree"] != main_root else f"session:{s['id']}"
        if groups.get(key, {}).get("sessions") and s["cwd"] != key:
            key = f"session:{s['id']}"
        if own in trees and own != main_root:
            key = own
        groups.setdefault(key, {"runs": [], "sessions": []})["sessions"].append(s)

    if only is not None:
        # A live Herdr lead owns one card, including every checkout/run it used.
        groups = {f"session:{s['id']}": {"sessions": [s],
                  "runs": [r for r in runs if r["session"] == s["id"]]} for s in sessions}
    cards, scopes = [], {}
    for key, g in groups.items():
        if only is not None and not g["sessions"]:
            continue
        tree_key = key
        if only is not None:
            candidates = [r.get("root") for r in reversed(g["runs"])]
            candidates += [s.get("worktree") or s.get("cwd") for s in g["sessions"]]
            tree_key = next((path for path in candidates if path in trees), "")
        tree = gc.detail(tree_key) if tree_key in trees else None
        if tree and (g["sessions"] or g["runs"]):
            scopes[key] = {"sessions": [s["id"] for s in g["sessions"]], "runs": [r["id"] for r in g["runs"]]}
            tree = {**tree, "own": own_count(repo, tree_key, scopes[key], now)}
            if tree_key == main_root:
                # Every session shares the main checkout: only this card's own edits mean it is building.
                tree["phase_edited"] = own_newest_edit(repo, tree_key, scopes[key], now)
        latest_run = g["runs"][-1] if g["runs"] else None
        owner = by_id.get((latest_run or {}).get("session")) \
            or max(g["sessions"], key=lambda s: (s["named"], s["updated"]), default=None)
        label = (latest_run or {}).get("unit") or (tree or {}).get("branch") or ""
        title = (owner or {}).get("name") or label or (latest_run or {}).get("goal", "")[:90] or key
        card = {"key": key, "repo": main_root, "title": title, "label": label, "tree": tree, "worktree": tree_key if tree else "",
                "goal": (latest_run or {}).get("goal", ""), "desc": (latest_run or {}).get("desc", ""),
                "sessions": [{**{k: s.get(k) for k in ("id", "name", "state", "updated", "branch", "model", "workflow_phase", "workflow_at", "workflow_history", "workflow_checks", "workflow_summary", "workflow_auditor", "workflow_runs", "task_tracking", "usage")},
                              "engine": s.get("engine") or "claude"} for s in g["sessions"]],
                "workflow_runs": [r for s in g["sessions"] for r in s.get("workflow_runs", [])],
                "runs": g["runs"][-6:],
                "rounds": round_list(sorted((r for r in g["runs"] if r["mode"] == "implement"), key=lambda r: r["started"] or r["updated"])),
                "chips": [c for s in g["sessions"] for c in s["chips"]][-6:],
                "fresh": bool(g["sessions"]) and not g["runs"] and all(s.get("fresh") for s in g["sessions"])}
        brief = newest_brief(repo, {b for x in g["sessions"] for b in by_id[x["id"]]["briefs"]}, key)
        if brief and brief[0] > (latest_run or {}).get("updated", 0):
            card["desc"] = brief[1]
        steps = [(board.get("steps") or {}).get(s["id"]) for s in g["sessions"]]
        card["steps"] = max([x for x in steps if isinstance(x, dict) and isinstance(x.get("items"), list)],
                            key=lambda x: x.get("at", ""), default={"items": []})["items"]
        card["now"] = [{**{k: s[k] for k in ("id", "name", "title", "state", "updated", "ask", "need", "action", "action_at", "action_running", "said", "said_at", "said_full", "docs")},
                        "question": s.get("question", ""),
                        "engine": s.get("engine", "claude"),
                        "agents": [{**{f: x[f] for f in ("id", "label", "state", "at")}, **{k: x[k] for k in ("shell", "task", "model", "tokens", "cost", "fill") if x.get(k)}} for x in s["agents"]]}
                       for s in sorted(g["sessions"], key=lambda s: -s["updated"])]
        card["declared"] = max((declared[s["id"]] for s in g["sessions"] if s["id"] in declared),
                               key=lambda d: d["at"], default=None)
        card["phase"] = phase_of(card, g["runs"], g["sessions"])
        card["usage"] = card_usage(g["sessions"])
        card["needs_you"] = [] if card["phase"] == "complete" else needs_you(card, g["runs"])
        impl = [r for r in g["runs"] if r["mode"] == "implement"]
        card["outside"] = impl[-1]["outside"] if impl and "out_of_scope" in card["needs_you"] else []
        card["updated"] = max([r["updated"] for r in g["runs"]] + [max(s["updated"], s.get("workflow_at", 0)) for s in g["sessions"]] + [0])
        card["favourite"] = any(k in favourites for k in [key] + [f"session:{s['id']}" for s in g["sessions"]])
        if card["phase"] == "idle" and now - card["updated"] > IDLE_DROP_S and not card["favourite"]:
            continue
        cards.append(card)
    shared = Counter(c["title"] for c in cards)
    for c in cards:
        if shared[c["title"]] > 1 and (c["tree"] or {}).get("branch"):
            c["title"] = c["tree"]["branch"].rsplit("/", 1)[-1]

    def attention(state):
        out = []
        for s in sessions:
            mine = [c for c in cards if any(x["id"] == s["id"] for x in c["sessions"])]
            card = next((c for c in mine if c["phase"] == "review"), mine[0] if mine else None)
            handed_back = card and card["phase"] == "review" and s["state"] in ("idle", "still_open") \
                and s["idle"] >= WAIT_MIN_S and not any(c["phase"] in ("implement", "rework", "audit") for c in mine)
            if ("waiting" if handed_back else s["state"]) != state:
                continue
            key = f"session:{s['id']}"
            if state == "still_open" and card and card["phase"] == "complete":
                continue
            out.append({**s, "key": key, "phase": card["phase"] if card else "", "card": card["key"] if card else ""})
        return sorted(out, key=lambda x: -x["updated"])

    return {
        "generated": now, "ui": ui_stamp(), "repo": main_root, "main": repo.main,
        "cards": sorted(cards, key=lambda c: -c["updated"]),
        "waiting": attention("waiting"), "still_open": attention("still_open"),
        "_sources": output_sources(sessions),
        "_docs": {s["id"]: {d["path"] for d in s["docs"]} |
                  ({s["task_tracking"]["file"]} if s.get("task_tracking", {}).get("file")
                   and not s["task_tracking"].get("error") else set()) for s in sessions},
        "_scopes": scopes,
        "session_panes": {**session_panes(repo), **{s["id"]: s["pane"] for s in sessions if s.get("pane")}},
        "abandoned": sorted(old, key=lambda r: -r["updated"])[:30],
        "locks": board.get("locks") or {}, "events": (board.get("events") or [])[-12:],
        "totals": totals(sessions, every, runs, now), "history": history_rows(every),
    }


def session_panes(repo):
    out = {}
    for base in repo.projects:
        for f in (base.parent / "sessions").glob("*.json"):
            sid = (load_json(f) or {}).get("sessionId")
            try:
                env = Path(f"/proc/{f.stem}/environ").read_bytes().split(b"\0")
            except OSError:
                continue
            pane = next((e[len(b"HERDR_PANE_ID="):].decode() for e in env if e.startswith(b"HERDR_PANE_ID=")), "")
            if sid and pane:
                out[sid] = pane
    return out


def output_sources(sessions):
    out = {}
    for s in sessions:
        for x in s["agents"]:
            out[f"{s['id']}/{x['id']}"] = x["path"]
    return out


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True

    def __init__(self, addr, repo, token):
        super().__init__(addr, Handler)
        self.repo, self.token, self.gc = repo, token, GitCache(repo)
        self.lock, self.cached, self.cached_at, self.sources, self.docs, self.scopes = threading.Lock(), None, 0.0, {}, {}, {}
        self.herdr_lock, self.herdr_cached, self.herdr_cached_at = threading.Lock(), None, 0.0
        self.herdr_live_lock, self.herdr_live = threading.Lock(), {}
        self.feed = ActivityFeed()
        self.roots, self.cwd_roots, self.card_roots, self.card_worktrees = {str(repo.root): (repo, self.gc)}, {}, {}, {}

    def repo_at(self, cwd):
        if cwd not in self.cwd_roots:
            root = None
            if repo_top(cwd):
                common = (git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir") or "").strip()
                root = str(Path(common).parent) if common.endswith("/.git") else None
                if root and root not in self.roots:
                    r = Repo(root, None, None)
                    self.roots[root] = (r, GitCache(r))
            self.cwd_roots[cwd] = root
        return self.roots.get(self.cwd_roots[cwd])

    def owner_of(self, key):
        """(Repo, GitCache) whose root or worktree is `key`, or the one that built card `key`."""
        root = self.card_roots.get(key)
        if root in self.roots:
            return self.roots[root]
        now = time.time()
        return next(((r, gc) for root, (r, gc) in self.roots.items() if key == root or key in gc.worktrees(now)), None)

    def build(self):
        herdr = self.herdr_state()
        if not herdr["running"]:
            return build_state(self.repo, self.gc)
        now, wanted, extra = time.time(), {}, {}
        agents = herdr_agents(herdr)
        for sid, (cwd, _) in agents.items():
            owner = self.repo_at(cwd)
            if owner:
                wanted.setdefault(str(owner[0].root), set()).add(sid)
        seen = {pane for _, pane in agents.values()}
        for pane in herdr["panes"]:
            owner = self.repo_at(pane["cwd"]) if pane.get("agent") and pane["pane_id"] not in seen else None
            if owner:
                s = pane_session(pane, str(owner[0].root), now)
                wanted.setdefault(str(owner[0].root), set()).add(s["id"])
                extra.setdefault(str(owner[0].root), []).append(s)
        pane_by_id = {p["pane_id"]: p for p in herdr["panes"]}
        bindings = {sid: pane_by_id[pane] for sid, (_, pane) in agents.items()}
        for additions in extra.values():
            for session in additions:
                bindings[session["id"]] = pane_by_id[session["pane"]]
        parts = [build_state(*self.roots[root], only=sids, extra=extra.get(root, []),
                             pane_bindings={sid: bindings[sid] for sid in sids}) for root, sids in wanted.items()]
        return merge_states(self.repo, parts, now)

    def state(self):
        with self.lock:
            if time.time() - self.cached_at > STATE_TTL_S:
                st = self.build()
                self.sources, self.docs, self.scopes = st.pop("_sources"), st.pop("_docs"), st.pop("_scopes")
                self.card_roots = {k: c["repo"] for c in st["cards"]
                                   for k in [c["key"], *(f"session:{s['id']}" for s in c["now"])]}
                self.card_worktrees = {c["key"]: c["worktree"] for c in st["cards"] if c.get("worktree")}
                st["activity"] = self.feed.update(st)
                st["plan"] = plan_usage()
                self.cached = json.dumps(st).encode()
                self.cached_at = time.time()
            return self.cached

    def herdr_state(self):
        with self.herdr_lock:
            if self.herdr_cached is None or time.time() - self.herdr_cached_at > HERDR_TTL_S:
                self.herdr_cached = read_herdr_snapshot()
                self.herdr_cached_at = time.time()
            return self.herdr_cached

    def invalidate_herdr(self):
        with self.herdr_lock:
            self.herdr_cached_at = 0
            self.herdr_cached = None


class Handler(http.server.BaseHTTPRequestHandler):
    server: Server
    protocol_version = "HTTP/1.1"
    timeout = 120
    body_read = False

    def log_message(self, fmt, *args):
        return

    def authorised(self, query):
        cookie = self.headers.get("Cookie") or ""
        given = (query.get("t") or [""])[0] or dict(
            p.strip().split("=", 1) for p in cookie.split(";") if "=" in p).get("fsa_t", "")
        return secrets.compare_digest(given, self.server.token)

    def send(self, code, body, ctype="application/json", extra=None):
        if ctype.startswith(("application/json", "text/plain")):
            body = redact(body)
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        if self.command == "POST" and not self.body_read:
            self.close_connection = True
            self.send_header("Connection", "close")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        try:
            self.wfile.write(body)
        except ConnectionError:
            pass

    def herdr_json_body(self):
        length_header = self.headers.get("Content-Length")
        if length_header is None or not re.fullmatch(r"\d+", length_header):
            self.send(413, b"invalid Content-Length", "text/plain")
            return False, None
        normalized_length = length_header.lstrip("0") or "0"
        if len(normalized_length) > 5 or int(normalized_length) > 65536:
            self.send(413, b"invalid Content-Length", "text/plain")
            return False, None
        if self.headers.get("Content-Type", "").split(";", 1)[0].strip().lower() != "application/json":
            self.send(415, b"Content-Type must be application/json", "text/plain")
            return False, None
        try:
            data = self.rfile.read(int(normalized_length))
            self.body_read = True
            return True, json.loads(data or b"{}")
        except (ValueError, TypeError):
            self.send(400, b"bad request", "text/plain")
            return False, None

    def herdr_upload_body(self):
        length_header = self.headers.get("Content-Length")
        if length_header is None or not re.fullmatch(r"\d+", length_header):
            self.send(413, b"invalid Content-Length", "text/plain")
            return None, None
        normalized_length = length_header.lstrip("0") or "0"
        if len(normalized_length) > 8:
            self.send(413, b"invalid Content-Length", "text/plain")
            return None, None
        length = int(normalized_length)
        if not 1 <= length <= HERDR_UPLOAD_MAX:
            self.send(413, b"invalid Content-Length", "text/plain")
            return None
        chunks, remaining = [], length
        while remaining:
            chunk = self.rfile.read(min(65536, remaining))
            if not chunk:
                self.send(400, b"incomplete upload body", "text/plain")
                return None
            chunks.append(chunk)
            remaining -= len(chunk)
        self.body_read = True
        return b"".join(chunks)

    def stage_herdr_upload(self, body, original):
        directory = Path(tempfile.gettempdir()) / f"fsa-dashboard-uploads-{os.geteuid()}"
        try:
            directory.mkdir(mode=0o700)
        except FileExistsError:
            pass
        directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            info = os.fstat(directory_fd)
            if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid():
                raise OSError("unsafe upload directory")
            os.fchmod(directory_fd, 0o700)
            cutoff = time.time() - 24 * 3600
            with os.scandir(directory_fd) as entries:
                for entry in entries:
                    try:
                        entry_info = entry.stat(follow_symlinks=False)
                    except FileNotFoundError:
                        continue
                    if stat.S_ISREG(entry_info.st_mode) and entry_info.st_mtime < cutoff:
                        try:
                            os.unlink(entry.name, dir_fd=directory_fd)
                        except FileNotFoundError:
                            pass
            safe = UNSAFE_NAME_RE.sub("_", Path(original).name).lstrip("._")[-120:] or "file"
            name = f"{secrets.token_hex(4)}-{safe}"
            path = directory / name
            flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
            fd = os.open(name, flags, 0o600, dir_fd=directory_fd)

            def remove_staged():
                try:
                    os.unlink(name, dir_fd=directory_fd)
                except FileNotFoundError:
                    pass

            try:
                os.fchmod(fd, 0o600)
                with os.fdopen(fd, "wb") as upload:
                    fd = -1
                    upload.write(body)
            except BaseException:
                if fd >= 0:
                    os.close(fd)
                remove_staged()
                raise
            try:
                current = os.lstat(directory)
            except OSError:
                remove_staged()
                raise
            if not stat.S_ISDIR(current.st_mode) or (current.st_dev, current.st_ino) != (info.st_dev, info.st_ino):
                remove_staged()
                raise OSError("upload directory changed")
            return path
        finally:
            os.close(directory_fd)

    def live_client_closed(self):
        try:
            readable, _, _ = select.select([self.connection], [], [], 0)
            return bool(readable) and self.connection.recv(1, socket.MSG_PEEK) == b""
        except (ConnectionError, OSError, ValueError):
            return True

    def live_event(self, event, data):
        try:
            self.wfile.write(b"event: " + event + b"\ndata: " + data + b"\n\n")
            self.wfile.flush()
            return True
        except (ConnectionError, OSError, ValueError):
            return False

    def live_stream(self, q):
        pane = (q.get("pane") or [""])[0]
        if pane not in {x["pane_id"] for x in self.server.herdr_state()["panes"]}:
            return self.send(404, b"unknown pane", "text/plain")
        try:
            cols, rows = int((q.get("cols") or [""])[0]), int((q.get("rows") or [""])[0])
        except (TypeError, ValueError):
            return self.send(400, b"bad terminal size", "text/plain")
        if not 10 <= cols <= 500 or not 5 <= rows <= 200:
            return self.send(400, b"bad terminal size", "text/plain")
        takeover = (q.get("takeover") or [""])[0]
        if takeover not in ("", "1"):
            return self.send(400, b"bad takeover", "text/plain")
        executable = shutil.which("herdr")
        if not executable:
            return self.send(503, b"herdr is not running", "text/plain")
        session_id = secrets.token_urlsafe(18)
        with self.server.herdr_live_lock:
            if len(self.server.herdr_live) >= HERDR_LIVE_MAX:
                return self.send(429, b"too many live terminal sessions", "text/plain")
            args = [executable, "terminal", "session", "control", pane, "--cols", str(cols), "--rows", str(rows)]
            if takeover == "1":
                args.append("--takeover")
            try:
                process = subprocess.Popen(args, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                           bufsize=0)
            except (OSError, ValueError):
                return self.send(503, b"herdr is not running", "text/plain")
            live = HerdrLiveSession(process)
            self.server.herdr_live[session_id] = live
        closed_reason = ""
        released = False
        try:
            self.send_response(200)
            self.close_connection = True
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Connection", "close")
            self.end_headers()
            if not self.live_event(b"ready", json.dumps({"session": session_id}, separators=(",", ":")).encode()):
                return
            keepalive_at = time.monotonic() + 15
            while True:
                if self.live_client_closed():
                    return
                try:
                    line = live.output.get(timeout=0.25)
                except queue.Empty:
                    if time.monotonic() >= keepalive_at:
                        try:
                            self.wfile.write(b": keepalive\n\n")
                            self.wfile.flush()
                        except (ConnectionError, OSError, ValueError):
                            return
                        keepalive_at = time.monotonic() + 15
                    continue
                if line is None:
                    break
                try:
                    message = json.loads(line)
                except (TypeError, ValueError):
                    continue
                if isinstance(message, dict) and message.get("type") == "terminal.closed":
                    reason = message.get("reason")
                    closed_reason = reason if isinstance(reason, str) else ""
                    break
                if isinstance(message, dict) and message.get("type") == "terminal.frame":
                    if not self.live_event(b"frame", line):
                        return
            live.release()
            released = True
            live.wait_for_error(2)
            reason = closed_reason or live.error_text() or "terminal session closed"
            self.live_event(b"closed", json.dumps({"reason": reason}, separators=(",", ":")).encode())
        except (ConnectionError, OSError, ValueError):
            pass
        finally:
            try:
                if not released:
                    live.release()
            finally:
                with self.server.herdr_live_lock:
                    if self.server.herdr_live.get(session_id) is live:
                        self.server.herdr_live.pop(session_id, None)

    def do_GET(self):
        url = urllib.parse.urlparse(self.path)
        q = urllib.parse.parse_qs(url.query)
        if not self.authorised(q):
            return self.send(403, b"forbidden: open the URL printed by 'fsa-dashboard start'", "text/plain")
        if url.path == "/":
            cookie = f"fsa_t={self.server.token}; HttpOnly; SameSite=Strict; Path=/; Max-Age=31536000"
            return self.send(200, HTML.read_bytes(), "text/html; charset=utf-8", {"Set-Cookie": cookie})
        if url.path == "/api/state":
            return self.send(200, self.server.state())
        if url.path == "/api/herdr":
            return self.send(200, json.dumps(self.server.herdr_state()).encode())
        if url.path == "/api/herdr/live":
            return self.live_stream(q)
        if url.path == "/api/herdr/screen":
            source = (q.get("source") or ["visible"])[0]
            if source not in ("visible", "recent"):
                return self.send(400, b"bad source", "text/plain")
            pane = (q.get("pane") or [""])[0]
            if pane not in {x["pane_id"] for x in self.server.herdr_state()["panes"]}:
                return self.send(404, b"unknown pane", "text/plain")
            screen = herdr_screen(pane, source)
            if screen is None:
                return self.send(503, b"herdr is not running", "text/plain")
            screen_hash = hashlib.sha1(screen).hexdigest()
            extra = {"X-Screen-Hash": screen_hash}
            if (q.get("since") or [""])[0] == screen_hash:
                return self.send(204, b"", "text/plain; charset=utf-8", extra)
            return self.send(200, screen, "text/plain; charset=utf-8", extra)
        if url.path in XTERM_FILES:
            path, ctype = XTERM_FILES[url.path]
            try:
                return self.send(200, path.read_bytes(), ctype)
            except OSError:
                return self.send(404, b"not found", "text/plain")
        if url.path == "/api/log":
            rid = (q.get("id") or [""])[0]
            if not RUN_ID_RE.match(rid):
                return self.send(400, b"bad run id", "text/plain")
            runs = dict.fromkeys(d for r, _ in self.server.roots.values() for d in r.run_dirs)
            log = next((d / f"{rid}.log" for d in runs if (d / f"{rid}.log").exists()), self.server.repo.runs / f"{rid}.log")
            full = (q.get("full") or [""])[0] == "1"
            lines = tail_lines(log, 400000 if full else 12000)
            return self.send(200, ANSI_RE.sub("", "\n".join(lines[-3000 if full else -120:])).encode(), "text/plain; charset=utf-8")
        if url.path == "/api/output":
            sid, aid = ((q.get(k) or [""])[0] for k in ("sid", "id"))
            if not SOURCE_ID_RE.match(sid) or not SOURCE_ID_RE.match(aid):
                return self.send(400, b"bad subagent id", "text/plain")
            self.server.state()
            path = self.server.sources.get(f"{sid}/{aid}")
            if not path:
                return self.send(404, b"unknown subagent", "text/plain")
            text = shell_output(path) if path.endswith(".output") else render_transcript(path)
            return self.send(200, text.encode(), "text/plain; charset=utf-8")
        if url.path == "/api/doc":
            sid, path = ((q.get(k) or [""])[0] for k in ("sid", "path"))
            self.server.state()
            if path not in self.server.docs.get(sid, ()):
                return self.send(404, b"not a file named in that session's last message", "text/plain")
            try:
                with open(path, "rb") as fh:
                    data = fh.read(DOC_BYTES)
            except OSError:
                return self.send(404, b"file unreadable", "text/plain")
            return self.send(200, data, "text/plain; charset=utf-8")
        if url.path in ("/api/changes", "/api/files", "/api/diff"):
            key = (q.get("key") or [""])[0]
            owner = self.server.owner_of(key) if key else None
            scope = self.server.scopes.get(key)
            key = self.server.card_worktrees.get(key, key)
            if not owner or key != str(owner[0].root) and key not in owner[1].worktrees(time.time()):
                return self.send(404, b"unknown worktree", "text/plain")
            repo = owner[0]
            if url.path == "/api/changes":
                items = change_items(key, repo.main)
                if scope:
                    items["own"] = sum(f["own"] for f in scoped_files(repo, key, scope, status_files(key)))
                return self.send(200, json.dumps(items).encode())
            ref = (q.get("ref") or [""])[0]
            if ref != WORKTREE_REF and not SHA_RE.match(ref):
                return self.send(400, b"bad ref", "text/plain")
            files = status_files(key) if ref == WORKTREE_REF else commit_files(key, ref)
            if ref == WORKTREE_REF and scope:
                files = scoped_files(repo, key, scope, files)
            if url.path == "/api/files":
                return self.send(200, json.dumps(files).encode())
            path = (q.get("path") or [""])[0]
            if path not in {f["path"] for f in files}:
                return self.send(404, b"not a changed file", "text/plain")
            return self.send(200, ref_diff(key, ref, path).encode(), "text/plain; charset=utf-8")
        return self.send(404, b"not found", "text/plain")

    def do_POST(self):
        self.body_read = False
        url = urllib.parse.urlparse(self.path)
        if not self.authorised({}) or url.path not in ("/api/favourite", "/api/herdr/send", "/api/herdr/action",
                                                          "/api/herdr/live/input", "/api/herdr/live/file"):
            return self.send(403, b"forbidden", "text/plain")
        if url.path == "/api/herdr/live/file":
            q = urllib.parse.parse_qs(url.query)
            session_id = (q.get("session") or [""])[0]
            with self.server.herdr_live_lock:
                live = self.server.herdr_live.get(session_id)
            if live is None:
                return self.send(404, b"unknown session", "text/plain")
            body = self.herdr_upload_body()
            if body is None:
                return
            try:
                path = self.stage_herdr_upload(body, (q.get("name") or ["file"])[0])
            except OSError:
                return self.send(500, b"failed to stage file", "text/plain")
            return self.send(200, json.dumps({"ok": True, "path": str(path)}).encode())
        if url.path in ("/api/herdr/send", "/api/herdr/action", "/api/herdr/live/input"):
            valid, body = self.herdr_json_body()
            if not valid:
                return
        if url.path == "/api/herdr/live/input":
            try:
                command = herdr_live_command(body)
            except (TypeError, ValueError):
                return self.send(400, b"bad request", "text/plain")
            with self.server.herdr_live_lock:
                live = self.server.herdr_live.get(body["session"])
            if live is None:
                return self.send(404, b"unknown session", "text/plain")
            try:
                live.write(command)
            except (BrokenPipeError, OSError, ValueError):
                return self.send(503, b"terminal session is closed", "text/plain")
            return self.send(200, b'{"ok":true}')
        if url.path == "/api/herdr/send":
            try:
                args = herdr_send_args(body, {x["pane_id"] for x in self.server.herdr_state()["panes"]})
            except LookupError:
                return self.send(404, b"unknown pane", "text/plain")
            except (ValueError, TypeError):
                return self.send(400, b"bad request", "text/plain")
            result = run_herdr(*args)
            self.server.invalidate_herdr()
            if result is not None and result.returncode == 0:
                reply = {"ok": True, "error": ""}
            else:
                output = b"" if result is None else result.stdout + result.stderr
                reply = {"ok": False, "error": output.decode("utf-8", "replace")[-2000:].strip() or "herdr is not running"}
            return self.send(200, json.dumps(reply).encode())
        if url.path == "/api/herdr/action":
            try:
                args, timeout = herdr_action_args(body, self.server.herdr_state())
            except LookupError:
                return self.send(404, b"unknown id", "text/plain")
            except (ValueError, TypeError):
                return self.send(400, b"bad request", "text/plain")
            result = run_herdr(*args, timeout=timeout)
            parsed = None
            if result is not None:
                try:
                    output_json = json.loads(result.stdout)
                    parsed = output_json.get("result") if isinstance(output_json, dict) else None
                except (TypeError, ValueError):
                    pass
            if body.get("action") == "session.create" and result is not None and result.returncode == 0:
                result = start_session(parsed, body["name"], body.get("engine", "claude"))
                self.server.cached_at = 0
            self.server.invalidate_herdr()
            if result is not None and result.returncode == 0:
                reply = {"ok": True, "error": "", "result": parsed}
            else:
                output = b"" if result is None else result.stdout + result.stderr
                reply = {"ok": False, "error": output.decode("utf-8", "replace")[-2000:].strip() or "herdr is not running",
                         "result": parsed}
            return self.send(200, json.dumps(reply).encode())
        try:
            data = self.rfile.read(int(self.headers.get("Content-Length") or 0))
            self.body_read = True
            body = json.loads(data or b"{}")
            raw = body["keys"]
            if not isinstance(raw, list):
                raise TypeError("keys must be a list")
            keys = [str(k)[:512] for k in raw][:64]
            on = bool(body.get("on", True))
        except (ValueError, KeyError, TypeError):
            return self.send(400, b"bad request", "text/plain")
        repo = (self.server.owner_of(keys[0]) or (self.server.repo,))[0] if keys else self.server.repo
        path = repo.favourites
        with self.server.lock:
            data = load_json(path) or {}
            for key in keys:
                if on:
                    data[key] = time.time()
                else:
                    data.pop(key, None)
            tmp = path.with_suffix(".tmp")
            tmp.write_text(json.dumps(data))
            tmp.replace(path)
            self.server.cached_at = 0
        return self.send(200, b"{}")


def token_for(repo):
    path = repo.state / "dashboard.token"
    if not path.exists():
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(secrets.token_urlsafe(24))
    return path.read_text().strip()


def host_ip():
    out = subprocess.run(["hostname", "-I"], capture_output=True, text=True).stdout.split()
    return next((ip for ip in out if not ip.startswith(("172.", "127."))), out[0] if out else "localhost")


FOLLOW_S = 30


def installed_dashboard(script):
    """The fsa-dashboard of the user-scope install of the plugin this cached copy belongs to, or None."""
    up = Path(script).resolve().parents
    if len(up) < 6 or up[4].name != "cache":
        return None
    data = load_json(up[5] / "installed_plugins.json") or {}
    for entry in (data.get("plugins") or {}).get(f"{up[2].name}@{up[3].name}", []):
        if entry.get("scope") == "user":
            found = Path(entry.get("installPath") or "/nonexistent") / "scripts" / "fsa-dashboard"
            return found if found.is_file() else None
    return None


def follow_updates(script):
    """Re-exec onto the installed copy once `claude plugin update` replaces the one serving."""
    while True:
        time.sleep(FOLLOW_S)
        found = installed_dashboard(script)
        if not found or found.resolve() == Path(script).resolve():
            continue
        try:
            compile(found.read_text(), str(found), "exec")
        except (OSError, SyntaxError, ValueError):
            continue
        os.execv(sys.executable, [sys.executable, str(found), *sys.argv[1:]])


def running_pid(port):
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit() or int(proc.name) == os.getpid():
            continue
        try:
            argv = (proc / "cmdline").read_bytes().decode(errors="replace").split("\0")
        except OSError:
            continue
        if not any(a.endswith("fsa-dashboard") for a in argv) or "serve" not in argv:
            continue
        given = argv[argv.index("--port") + 1] if "--port" in argv[:-1] else "8766"
        if given == str(port):
            return int(proc.name)
    return None


def stop_server(pid):
    os.kill(pid, signal.SIGTERM)
    for _ in range(30):
        if not Path(f"/proc/{pid}").exists():
            return
        time.sleep(0.1)
    os.kill(pid, signal.SIGKILL)


def main():
    ap = argparse.ArgumentParser(prog="fsa-dashboard")
    ap.add_argument("cmd", choices=["start", "stop", "status", "serve", "state"])
    ap.add_argument("--repo", default=os.getcwd())
    ap.add_argument("--runs")
    ap.add_argument("--projects", action="append")
    ap.add_argument("--host", default=os.environ.get("FSA_DASHBOARD_HOST", "0.0.0.0"))
    ap.add_argument("--port", type=int, default=int(os.environ.get("FSA_DASHBOARD_PORT", "8766")))
    args = ap.parse_args()
    repo = Repo(args.repo, args.runs, args.projects)
    token = token_for(repo)
    url = f"http://{host_ip()}:{args.port}/?t={token}"
    pid = running_pid(args.port)

    if args.cmd == "state":
        st = build_state(repo, GitCache(repo))
        st.pop("_sources"), st.pop("_docs"), st.pop("_scopes")
        print(json.dumps(st, indent=1))
    elif args.cmd == "serve":
        srv = Server((args.host, args.port), repo, token)
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        threading.Thread(target=follow_updates, args=(__file__,), daemon=True).start()
        srv.serve_forever()
    elif args.cmd == "start":
        if not pid:
            log = open(repo.state / "dashboard.log", "ab")
            cmd = [sys.executable, str(Path(__file__).resolve()), "serve", "--repo", str(repo.root),
                   "--runs", str(repo.runs), "--host", args.host, "--port", str(args.port)]
            for p in args.projects or []:
                cmd += ["--projects", p]
            subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
            time.sleep(1.5)
            if not running_pid(args.port):
                sys.exit(f"fsa-dashboard: failed to start; see {repo.state / 'dashboard.log'}")
        print(url)
    elif args.cmd == "stop":
        if pid:
            stop_server(pid)
        print("stopped" if pid else "not running")
    else:
        print(url if pid else "not running")


if __name__ == "__main__":
    main()
