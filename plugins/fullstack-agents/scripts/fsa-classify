#!/usr/bin/env python3
"""Typed Haiku decisions: route a prompt to skills, classify whether a reply waits on the user, or a Codex turn's phase."""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
SKILLS = HERE.parent / "skills"
MODEL = os.environ.get("FSA_CLASSIFIER_MODEL", "haiku")
TIMEOUT_S = float(os.environ.get("FSA_CLASSIFIER_TIMEOUT", "25"))
MIN_ROUTE_CONF = float(os.environ.get("FSA_ROUTER_MIN_CONFIDENCE", "0.55"))
MIN_WAIT_CONF = float(os.environ.get("FSA_WAIT_MIN_CONFIDENCE", "0.6"))
INTENTS = ["question", "investigate", "debug", "performance", "plan", "implement", "review", "deploy", "other"]
LANES = ["rust", "python", "frontend", "infra", "docs", "plugin", "none"]
WORKERS = ["none", "bounded-extractor", "test-runner", "diff-reviewer", "implementer"]
AWAITING = ["approval", "decision", "answer", "action", "review", "none"]
PHASES = ["investigate", "plan", "implement", "audit", "review"]
LOG = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude") / "fullstack-agents" / "classifier.jsonl"

ROUTE_SYSTEM = """You route a developer's prompt for a Claude Code session lead in a fullstack repository.
Pick the intent, the code lanes the work touches, the skills the lead must load before reasoning,
and whether a worker agent fits. Judge from what the user wants done, not from words inside pasted
logs, plans or code. A short reply such as "go ahead" or "approved" continues the previous turn:
use the previous assistant message to decide. Choose only skills whose description matches the
work; fewer is better. The PROJECT line says which stacks exist: a bug in a call, queue, API or
database path of a Rust backend is the rust lane even when the prompt does not say "Rust".
confidence: 0.9 when the prompt clearly names the work, 0.75 when you infer the lane from the
project, 0.5 or less when the request itself is unclear."""

WAIT_SYSTEM = """You read the final message an AI coding assistant sent to its user when its turn ended,
and decide whether the work now waits on the user. The assistant has stopped: nothing moves until the
user replies, so judge what the user must do next, not whether the message ends with a question.
approval: it needs a go-ahead for a plan, a risky step, or work it says it will do once authorised.
decision: it lists open decisions, options or recommended defaults for the user to confirm or change.
answer: it asks a question it needs answered.
action: the user must do something outside the session (send a message, change a permission, log in,
copy a file somewhere permanent).
review: it delivers findings, an investigation, a design, a review or an answer the user asked for,
and the next step depends on the user reading it.
none: only an interim progress note, an acknowledgement, or work completed end to end (shipped,
verified) with nothing left for the user to decide or do.
When the message is long, the PART markers show its opening and its ending; both count.
need is one short line saying what the user must do; empty for none. confidence: 0.9 when the
category is plain, 0.7 when you infer it, 0.5 or less only when the message is truly ambiguous."""


def skill_catalogue():
    out = {}
    for f in sorted(SKILLS.glob("*/SKILL.md")):
        head = f.read_text(encoding="utf-8", errors="replace")[:1500]
        name = re.search(r"^name:\s*(.+)$", head, re.M)
        desc = re.search(r"^description:\s*(.+)$", head, re.M)
        if name:
            out[name.group(1).strip()] = (desc.group(1).strip() if desc else "")[:140]
    return out


def project_profile(cwd):
    root = Path(cwd or ".")
    marks = []
    found = lambda *globs: any(next(root.glob(g), None) for g in globs)
    if found("Cargo.toml", "*/Cargo.toml", "*/*/Cargo.toml"):
        marks.append("Rust (Cargo)")
    if found("next.config.*", "*/next.config.*", "*/*/next.config.*"):
        marks.append("Next.js frontend")
    if found("pyproject.toml", "*/pyproject.toml", "requirements.txt"):
        marks.append("Python")
    if found("docker-compose*.yml", "compose*.yml"):
        marks.append("Docker compose")
    return f"{root.name}: {', '.join(marks) or 'unknown stack'}"


PHASE_SYSTEM = """You read the latest turn of an AI coding agent (Codex) working for a developer: the
developer's last request, the agent's recent tool calls, and its latest message. Decide which phase the
task is in and whether the work now waits on the developer.
investigate: reading code, logs or data to understand or diagnose; no plan proposed yet.
plan: proposing or writing a plan, brief or design that is not implemented yet.
implement: editing files, writing code or migrations, or running the build for its own change.
audit: the change is made and the agent is testing, reviewing or verifying it, or handed it to a reviewer.
review: the agent has handed results, findings or finished work back for the developer to read or decide.
awaiting follows the same rule as for any final message: approval, decision, answer, action or review
when the developer must act before anything moves, none when the agent is still working or finished
with nothing left for the developer. need is one short line saying what the developer must do; empty for
none. confidence: 0.9 when the turn is plain, 0.7 when you infer it, 0.5 or less when it is ambiguous."""


def codex_turn(transcript, limit=4000):
    """The last request, recent tool calls and latest message of a Codex rollout, as classifier input."""
    try:
        with open(transcript, "rb") as fh:
            fh.seek(max(0, os.path.getsize(transcript) - 400000))
            lines = fh.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return ""
    ask, said, calls = "", "", []
    for line in lines:
        try:
            d = json.loads(line)
        except ValueError:
            continue
        p = d.get("payload") or {}
        if d.get("type") != "response_item":
            continue
        if p.get("type") == "message":
            text = "\n".join(c.get("text", "") for c in p.get("content") or []
                             if isinstance(c, dict) and c.get("type") in ("input_text", "output_text")).strip()
            if p.get("role") == "user" and text and not text.startswith("<"):
                ask, calls = text, []
            elif p.get("role") == "assistant" and text:
                said = text
        elif p.get("type") in ("function_call", "custom_tool_call"):
            raw = " ".join(str(p.get("arguments") or p.get("input") or "").split())
            calls.append(f"{p.get('name', '')}: {raw[:160]}")
    if not ask and not said:
        return ""
    head = limit // 3
    said = said if len(said) <= limit else f"[PART: opening]\n{said[:head]}\n[PART: ending]\n{said[head - limit:]}"
    tools = "\n".join(calls[-12:]) or "(none)"
    return f"REQUEST:\n{ask[-1500:]}\n\nRECENT TOOL CALLS:\n{tools}\n\nLATEST MESSAGE:\n{said}"


def last_assistant_text(transcript, limit=1500):
    try:
        with open(transcript, "rb") as fh:
            fh.seek(max(0, os.path.getsize(transcript) - 400000))
            lines = fh.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return ""
    for line in reversed(lines):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if d.get("type") != "assistant" or d.get("isSidechain"):
            continue
        texts = [c.get("text", "") for c in (d.get("message") or {}).get("content") or []
                 if isinstance(c, dict) and c.get("type") == "text"]
        if texts and texts[-1].strip():
            text = texts[-1].strip()
            if len(text) <= limit:
                return text
            head = limit // 3
            return f"[PART: opening]\n{text[:head]}\n[PART: ending]\n{text[head - limit:]}"
    return ""


def ask_haiku(system, user, schema):
    cmd = os.environ.get("FSA_CLASSIFIER_CMD")
    sys.path.insert(0, str(HERE / "lib"))
    import claude_cli
    try:
        launcher = cmd.split() if cmd else claude_cli.argv()
    except claude_cli.MissingAlias as error:
        log({"mode": "launch", "error": str(error)})
        return None, 0.0
    argv = launcher if cmd else launcher + [
        "-p", "--model", MODEL, "--setting-sources", "", "--strict-mcp-config", "--tools", "",
        "--no-session-persistence", "--output-format", "json", "--json-schema", json.dumps(schema),
        "--system-prompt", system]
    cwd = tempfile.mkdtemp(prefix="fsa-classify-")
    started = time.time()
    try:
        proc = subprocess.run(argv, input=user, capture_output=True, text=True, timeout=TIMEOUT_S, cwd=cwd,
                              env={**os.environ, "FSA_CLASSIFIER_RUN": "1"})
        result = json.loads(proc.stdout.strip().splitlines()[0]) if proc.stdout.strip() else {}
    except (subprocess.TimeoutExpired, OSError, ValueError, IndexError):
        result = {}
    finally:
        shutil.rmtree(cwd, ignore_errors=True)
    out = result.get("structured_output") if isinstance(result, dict) and not result.get("is_error") else None
    return out if isinstance(out, dict) else None, round(time.time() - started, 2)


def log(entry):
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with LOG.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps({"at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), **entry}) + "\n")
    except OSError:
        pass


def route(hook):
    prompt = str(hook.get("prompt") or "").strip()
    if not prompt:
        return 1
    skills = skill_catalogue()
    schema = {"type": "object", "additionalProperties": False,
              "required": ["intent", "lanes", "skills", "worker", "confidence", "reason"],
              "properties": {
                  "intent": {"type": "string", "enum": INTENTS},
                  "lanes": {"type": "array", "items": {"type": "string", "enum": LANES}, "maxItems": 3},
                  "skills": {"type": "array", "items": {"type": "string", "enum": sorted(skills)}, "maxItems": 6},
                  "worker": {"type": "string", "enum": WORKERS},
                  "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                  "reason": {"type": "string", "maxLength": 160}}}
    catalogue = "\n".join(f"- {k}: {v}" for k, v in skills.items())
    previous = last_assistant_text(hook.get("transcript_path") or "", 800)
    user = (f"PROJECT: {project_profile(hook.get('cwd'))}\n\nSKILLS:\n{catalogue}\n\nPREVIOUS ASSISTANT MESSAGE (context only):\n{previous or '(none)'}\n\n"
            f"USER PROMPT:\n{prompt[:4000]}")
    out, took = ask_haiku(ROUTE_SYSTEM, user, schema)
    log({"mode": "prompt", "session": hook.get("session_id", ""), "prompt": prompt[:300], "decision": out, "seconds": took})
    if not out or out.get("confidence", 0) < MIN_ROUTE_CONF:
        return 1
    picked = [s for s in out.get("skills", []) if s in skills]
    if out.get("intent") not in ("question", "other") and "task-flow" in skills and "task-flow" not in picked:
        picked.insert(0, "task-flow")
    lanes = [x for x in out.get("lanes", []) if x != "none"]
    line = (f"[fullstack-agents] router ({MODEL}, {out['confidence']:.2f}): intent {out['intent']}, "
            f"lanes {', '.join(lanes) or 'any'}")
    line += f" -> invoke via the Skill tool (fullstack-agents:*): {', '.join(picked)}" if picked else " -> no skill needed"
    if out.get("worker") not in (None, "none"):
        line += f"; worker that fits: {out['worker']}"
    print(f"{line}. Why: {out.get('reason', '')}. Name any skill you skip and the reason; the conclusion stays yours.")
    print(next((x for x in lanes if x in ("rust", "python", "frontend", "infra")), ""))
    return 0


def wait(hook):
    if hook.get("stop_hook_active"):
        return 0
    text = last_assistant_text(hook.get("transcript_path") or "", 4000)
    sid = hook.get("session_id") or ""
    if not text or not sid:
        return 0
    schema = {"type": "object", "additionalProperties": False, "required": ["awaiting", "need", "confidence"],
              "properties": {"awaiting": {"type": "string", "enum": AWAITING},
                             "need": {"type": "string", "maxLength": 200},
                             "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}
    out, took = ask_haiku(WAIT_SYSTEM, f"FINAL MESSAGE:\n{text}", schema)
    log({"mode": "reply", "session": sid, "tail": text[-300:], "decision": out, "seconds": took})
    if out and out.get("awaiting") != "none" and out.get("confidence", 0) >= MIN_WAIT_CONF and out.get("need", "").strip():
        need = f"{out['awaiting']}: {out['need'].strip()}"
        subprocess.run([str(HERE / "team-board"), "--session", sid, "wait", need], capture_output=True, timeout=10,
                       cwd=hook.get("cwd") or None)
    return 0


def phase(hook):
    text = codex_turn(hook.get("transcript_path") or "")
    sid = hook.get("session_id") or ""
    if not text or not sid:
        return 0
    schema = {"type": "object", "additionalProperties": False,
              "required": ["phase", "awaiting", "need", "confidence"],
              "properties": {"phase": {"type": "string", "enum": PHASES},
                             "awaiting": {"type": "string", "enum": AWAITING},
                             "need": {"type": "string", "maxLength": 200},
                             "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}
    out, took = ask_haiku(PHASE_SYSTEM, text, schema)
    log({"mode": "phase", "session": sid, "tail": text[-300:], "decision": out, "seconds": took})
    if not out or out.get("confidence", 0) < MIN_WAIT_CONF:
        return 0
    board = [str(HERE / "team-board"), "--session", sid]
    subprocess.run(board + ["phase", out["phase"], "--note", "classified"], capture_output=True, timeout=10,
                   cwd=hook.get("cwd") or None)
    if out.get("awaiting") != "none" and out.get("need", "").strip():
        subprocess.run(board + ["wait", f"{out['awaiting']}: {out['need'].strip()}"], capture_output=True, timeout=10,
                       cwd=hook.get("cwd") or None)
    return 0


def main():
    modes = {"prompt": route, "reply": wait, "phase": phase}
    if os.environ.get("FSA_CLASSIFIER_RUN") or len(sys.argv) != 2 or sys.argv[1] not in modes:
        return 2
    try:
        hook = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        return 2
    return modes[sys.argv[1]](hook)


if __name__ == "__main__":
    sys.exit(main())
